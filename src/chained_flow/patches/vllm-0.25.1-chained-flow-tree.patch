+def _tree_attention_fixup(
+    impl: "FlashAttentionImpl",
+    ts,
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    output: torch.Tensor,
+    attn_metadata: "FlashAttentionMetadata",
+    q_descale=None,
+    k_descale=None,
+    v_descale=None,
+) -> None:
+    """Recompute the DRAFT-TREE query rows under an ancestor mask.
+
+    FlashAttention's causal mask is over FLAT token order, so sibling tree nodes
+    would attend to each other.  The exact tree result decomposes into
+
+        softmax over [ shared prefix ] u [ own tree nodes, ancestor-masked ]
+
+    which is two independent attentions merged by log-sum-exp -- exactly the
+    cascade-attention trick vLLM already uses.  The prefix half is a normal
+    paged FlashAttention call with ``causal=False`` and ``seqused_k = ctx_len``
+    (every node sees the whole committed prefix); the suffix half is a dense
+    N x N attention (N <= a handful of draft nodes) with the ancestor mask.
+    """
+    idx = ts.tree_token_idx
+    idx_pad = ts.extras["idx_pad"]  # [S, Nmax]
+    valid_pad = ts.extras["valid_pad"]  # [S, Nmax]
+    nmax = ts.extras["nmax"]
+    S = ts.extras["num_spec"]
+
+    q = query.index_select(0, idx)  # [M, H, D]
+    M, H, D = q.shape
+    block_table = attn_metadata.block_table.index_select(0, ts.spec_req_idx)
+
+    prefix_out, prefix_lse = flash_attn_varlen_func(
+        q=q,
+        k=key_cache,
+        v=value_cache,
+        cu_seqlens_q=ts.cu_q,
+        max_seqlen_q=nmax,
+        seqused_k=ts.ctx_lens,
+        max_seqlen_k=ts.extras["max_ctx"],
+        softmax_scale=impl.scale,
+        causal=False,
+        alibi_slopes=impl.alibi_slopes,
+        block_table=block_table,
+        softcap=impl.logits_soft_cap,
+        fa_version=impl.vllm_flash_attn_version,
+        q_descale=q_descale[:S] if q_descale is not None else None,
+        k_descale=k_descale[:S] if k_descale is not None else None,
+        v_descale=v_descale[:S] if v_descale is not None else None,
+        return_softmax_lse=True,
+    )
+
+    # CF_TREE_FUSED_ATTN=1: the whole suffix half + the LSE merge in ONE CUDA
+    # launch instead of the ~16 eager ops below.  Restricted to the static
+    # FULL-cudagraph step (no padded rows), which is the shipping shape; the
+    # kernel returns False for any head_size/layout it is not built for and we
+    # fall through to the eager chain.
+    if tree_attn_fused.enabled() and ts.extras.get("static"):
+        # CF_TFA_CHECK=1 runs the eager tail ALONGSIDE the kernel and tallies
+        # mismatching elements in a device counter (cudagraph-safe, no sync);
+        # CF_TFA_CHECK=2 is the control that runs the eager tail only.
+        chk = tree_attn_fused.check_mode()
+        if chk:
+            ref = _tree_suffix_eager(
+                impl, ts, query, key, value, output, prefix_out, prefix_lse,
+                idx_pad, S, nmax, H, D
+            )
+            if chk == 2:
+                output.index_copy_(0, idx, ref.to(output.dtype))
+                return
+            tree_attn_fused.fused_suffix_merge(
+                query=query, key=key, value=value, output=output,
+                prefix_out=prefix_out, prefix_lse=prefix_lse, idx_pad=idx_pad,
+                not_anc=ts.extras["not_anc"], scale=impl.scale, S=S, N=nmax,
+            )
+            got = output.index_select(0, idx)
+            tkey = f"S{S}xN{nmax}xH{H}xHKV{key.shape[1]}xD{D}"
+            tree_attn_fused.tally(got, ref, key=tkey)
+            if tree_attn_fused.capturing():
+                # same NaN exclusion as tally(): both-NaN rows are not a
+                # mismatch, and they are common enough to swallow the capture
+                tree_attn_fused.capture(
+                    ((got != ref) & ~(got.isnan() & ref.isnan())).any(),
+                    dict(
+                        q=query.index_select(0, idx_pad.view(-1)),
+                        k=key.index_select(0, idx_pad.view(-1)),
+                        v=value.index_select(0, idx_pad.view(-1)),
+                        prefix_out=prefix_out,
+                        prefix_lse=prefix_lse,
+                        not_anc=ts.extras["not_anc"],
+                        got=got,
+                        ref=ref,
+                    ),
+                    key=tkey,
+                )
+            return
+        if tree_attn_fused.fused_suffix_merge(
+            query=query,
+            key=key,
+            value=value,
+            output=output,
+            prefix_out=prefix_out,
+            prefix_lse=prefix_lse,
+            idx_pad=idx_pad,
+            not_anc=ts.extras["not_anc"],
+            scale=impl.scale,
+            S=S,
+            N=nmax,
+        ):
+            return
+
+    output.index_copy_(
+        0,
+        idx,
+        _tree_suffix_eager(
+            impl, ts, query, key, value, output, prefix_out, prefix_lse,
+            idx_pad, S, nmax, H, D
+        ).to(output.dtype),
+    )
+
+
+def _tree_suffix_eager(
+    impl, ts, query, key, value, output, prefix_out, prefix_lse, idx_pad,
+    S, nmax, H, D,
+):
+    """The eager suffix half + LSE merge -- the reference the CUDA kernel must
+    reproduce bit for bit.  Returns the merged [S*nmax, H, D] rows."""
+    # --- dense ancestor-masked attention over this request's own tree nodes ---
+    Hkv = key.shape[1]
+    rep = H // Hkv
+    qp = query.index_select(0, idx_pad.view(-1)).view(S, nmax, H, D)
+    kp = key.index_select(0, idx_pad.view(-1)).view(S, nmax, Hkv, D)
+    vp = value.index_select(0, idx_pad.view(-1)).view(S, nmax, Hkv, D)
+    if rep > 1:
+        kp = kp.repeat_interleave(rep, dim=2)
+        vp = vp.repeat_interleave(rep, dim=2)
+    # [S, H, N, N]
+    scores = torch.einsum("snhd,smhd->shnm", qp.float(), kp.float()) * impl.scale
+    # in-place, on a precomputed negated mask: `masked_fill(~anc_mask)` allocated a new
+    # [S, H, N, N] tensor and re-negated the mask once per attention layer.
+    scores.masked_fill_(ts.extras["not_anc"].unsqueeze(1), float("-inf"))
+    smax = scores.amax(dim=-1, keepdim=True)
+    exp = torch.exp(scores - smax)
+    denom = exp.sum(dim=-1, keepdim=True)
+    suffix_lse = (smax + torch.log(denom)).squeeze(-1)  # [S, H, N]
+    probs = exp / denom
+    suffix_out = torch.einsum("shnm,smhd->snhd", probs, vp.float())
+
+    # Compact the padded rows with index_select on a PRECOMPUTED int index --
+    # never `x[bool_mask]`.  Boolean-mask indexing has a data-dependent output
+    # shape, so torch must SYNCHRONIZE THE DEVICE to learn it, and this runs once
+    # per attention layer: the mask form cost 2 x n_attn_layers host syncs inside
+    # every verify forward and made the forward impossible to pipeline (measured
+    # 16 syncs/step at 4B, _model_forward blocking 12.4 ms of host time against
+    # 7.6 ms of GPU work).  `valid_idx` is built host-side in
+    # tree_state.build_attn_plumbing from the same `valid` array.
+    flat_idx = ts.extras["valid_idx"]
+    suffix_out = suffix_out.reshape(S * nmax, H, D).index_select(0, flat_idx).to(output.dtype)
+    suffix_lse = (
+        suffix_lse.permute(0, 2, 1).reshape(S * nmax, H).index_select(0, flat_idx).transpose(0, 1)
+    ).contiguous()
+
+    merged = torch.empty_like(prefix_out)
+    merge_attn_states(
+        merged, prefix_out, prefix_lse, suffix_out, suffix_lse.float()
+    )
+    return merged
+
