+// SPDX-License-Identifier: Apache-2.0
+//
+// CF_GDN_CUDA=1 -- raw-CUDA, BIT-EXACT replacement for the Triton
+// `_tree_gdn_kernel` on the CF_GDN_DEFER path.  Same recurrence, same arithmetic
+// ORDER, same transcendental instructions; the only thing that changes is the
+// launch geometry, which is what the Triton version was actually losing to.
+//
+// WHY THIS IS ALLOWED TO BE FAST.  ncu on the Triton kernel at the shipping shape
+// (41 rows, 24 GDN layers, fp32 state):
+//     L2 throughput  16.2%   DRAM throughput 2.0%   L2 hit rate 97.1%
+//     issue slots busy 31.4%   achieved occupancy 15.35% (7.37 of 48 warps/SM)
+//     registers/thread 210 -> Block Limit Registers = 8   spills 0
+// It is not bandwidth bound anywhere near the roofline (82 MiB/layer of L2 reads
+// against a measured 30 TB/s of L2 read bandwidth is a 2.9 us floor, versus 70 us
+// measured).  It is LATENCY bound because 210 registers/thread cap it at 8 warps
+// per SM, and 210 registers is a consequence of the block shape: Triton's layout
+// for the [BV,BK] state tile is sizePerThread=[1,4], threadsPerWarp=[1,32], so
+// each thread holds ALL BV v-rows x 4 k-columns = 4*BV floats live.
+//
+// THE FIX IS THE GEOMETRY, NOT THE MATH.  Shrinking BV shrinks the live register
+// set proportionally and does NOT touch the reduction order, because the
+// reduction runs along K (the axis that is spread across lanes) and BV only
+// controls how many times each thread walks that reduction.  So BV=16 is
+// bit-exact and 1.44x faster even in Triton (measured: 69.98 -> 48.59 us).  This
+// kernel takes that further: one INDEPENDENT warp per (v-block, head, row) with
+// several warps per block, so the scheduler has real work to interleave.
+//
+// BIT-EXACTNESS -- reproduced instruction for instruction from the Triton PTX:
+//   * lane l owns k = 4l..4l+3 (contiguous, order=[1,0]); every thread holds
+//     every v-row of its BV slice.  Any other assignment changes the reduction.
+//   * a length-K dot is a per-lane 4-term chain `mul; fma; fma; fma` followed by
+//     a butterfly `x += shfl_bfly(x, d)` for d = 16, 8, 4, 2, 1 -- own operand
+//     FIRST in the add, which is what Triton's `standard.py` reduce emits.
+//   * tl.exp -> `ex2.approx.f32` after a multiply by log2(e), i.e. __expf, NOT
+//     the accurate expf.  tl.log -> the ACCURATE __nv_logf, i.e. logf.
+//     tl.sigmoid -> `div.full.f32`, i.e. __fdividef.  tl.rsqrt ->
+//     `rsqrt.approx.ftz.f32`, which no CUDA intrinsic spells exactly, so it is
+//     inline PTX below.
+//   * the rank-1 update is `fma(v2, b_k, h2)` and the q scaling is TWO separate
+//     multiplies (by rsqrt, then by `scale`), never folded into one.
+// Verified element-for-element against the Triton kernel: 0 differing elements in
+// `o` and 0 in the written state, over the 41-node shipping shape.
+//
+// MUST NOT be compiled with -use_fast_math: that would swap logf for __logf and
+// break the softplus.
+
+#include <torch/extension.h>
+
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+
+#include <cstdint>
+
+namespace {
+
+__device__ __forceinline__ float cvt(const __half x) { return __half2float(x); }
+__device__ __forceinline__ float cvt(const __nv_bfloat16 x) {
+  return __bfloat162float(x);
+}
+__device__ __forceinline__ float cvt(const float x) { return x; }
+__device__ __forceinline__ void rcvt(__half &d, float x) { d = __float2half(x); }
+__device__ __forceinline__ void rcvt(__nv_bfloat16 &d, float x) {
+  d = __float2bfloat16(x);
+}
+__device__ __forceinline__ void rcvt(float &d, float x) { d = x; }
+
+// dtype codes for the scalar side inputs (A_log, dt_bias, a, b).
+constexpr int DT_F32 = 0, DT_F16 = 1, DT_BF16 = 2;
+
+__device__ __forceinline__ float ld_any(const void *__restrict__ p, int code,
+                                        long i) {
+  if (code == DT_F32) return reinterpret_cast<const float *>(p)[i];
+  if (code == DT_F16)
+    return __half2float(reinterpret_cast<const __half *>(p)[i]);
+  return __bfloat162float(reinterpret_cast<const __nv_bfloat16 *>(p)[i]);
+}
+
+// Vectorised loads.  ncu says BOTH this kernel and the Triton one it replaces are
+// L1/TEX-THROUGHPUT bound (75.8% / 71.5%), not L2 (22%) and nowhere near DRAM
+// (2.6%) -- so every avoidable LSU transaction is a first-class cost.  Reading
+// the 4 k-columns as 4 scalar 2-byte loads instead of one 8-byte load, and the BV
+// v-values as BV scalar loads instead of BV*2/16 vector loads, was worth 4.4% of
+// the issued instructions and ~6 us.
+template <int BYTES> struct VecB;
+template <> struct VecB<4> { using type = uint32_t; };
+template <> struct VecB<8> { using type = uint2; };
+template <> struct VecB<16> { using type = uint4; };
+
+template <typename T, int N>
+__device__ __forceinline__ void ldvec(const T *__restrict__ p, float *o) {
+  constexpr int B = N * (int)sizeof(T);
+  if (B == 4 || B == 8 || B == 16) {
+    using VT = typename VecB<(B == 4 || B == 8 || B == 16) ? B : 16>::type;
+    VT raw = *reinterpret_cast<const VT *>(p);
+    const T *t = reinterpret_cast<const T *>(&raw);
+#pragma unroll
+    for (int i = 0; i < N; ++i) o[i] = cvt(t[i]);
+  } else {
+#pragma unroll
+    for (int i = 0; i < N; ++i) o[i] = cvt(p[i]);
+  }
+}
+
+// `rsqrt.approx.ftz.f32` -- what tl.rsqrt lowers to.  rsqrtf() emits the
+// non-ftz form and __frsqrt_rn() the IEEE one; neither matches.
+__device__ __forceinline__ float rsqrt_ftz(float x) {
+  float r;
+  asm("rsqrt.approx.ftz.f32 %0, %1;" : "=f"(r) : "f"(x));
+  return r;
+}
+
+// PACKED f32x2.  Blackwell issues `mul.f32x2` / `fma.rn.f32x2` as ONE instruction
+// for two independent IEEE f32 operations -- so it is bit-exact by construction,
+// and Triton's codegen leans on it heavily (220 packed ops in the PTX for this
+// kernel, against 0 in the first version of this file).  The elementwise halves
+// of the recurrence -- `b_h * exp(b_g)`, the rank-1 update and the k
+// normalisation -- are exactly the shape that packs; the DOTS are not, because
+// they are a serial dependency chain, and Triton keeps those scalar too.
+#if __CUDA_ARCH__ >= 1000
+#define CF_HAS_F32X2 1
+#endif
+
+__device__ __forceinline__ float2 mul2(float2 a, float2 b) {
+#ifdef CF_HAS_F32X2
+  unsigned long long ra, rb, rd;
+  __builtin_memcpy(&ra, &a, 8);
+  __builtin_memcpy(&rb, &b, 8);
+  asm("mul.f32x2 %0, %1, %2;" : "=l"(rd) : "l"(ra), "l"(rb));
+  float2 r;
+  __builtin_memcpy(&r, &rd, 8);
+  return r;
+#else
+  return make_float2(a.x * b.x, a.y * b.y);
+#endif
+}
+
+__device__ __forceinline__ float2 fma2(float2 a, float2 b, float2 c) {
+#ifdef CF_HAS_F32X2
+  unsigned long long ra, rb, rc, rd;
+  __builtin_memcpy(&ra, &a, 8);
+  __builtin_memcpy(&rb, &b, 8);
+  __builtin_memcpy(&rc, &c, 8);
+  asm("fma.rn.f32x2 %0, %1, %2, %3;" : "=l"(rd) : "l"(ra), "l"(rb), "l"(rc));
+  float2 r;
+  __builtin_memcpy(&r, &rd, 8);
+  return r;
+#else
+  return make_float2(fmaf(a.x, b.x, c.x), fmaf(a.y, b.y, c.y));
+#endif
+}
+
+// Triton's cross-lane reduce: butterfly, own operand first in the add.
+__device__ __forceinline__ float bfly_sum(float x) {
+#ifdef CF_NOBFLY
+  return x;  // NOT correct -- A/A control only, to price the cross-lane reduce
+#else
+#pragma unroll
+  for (int d = 16; d; d >>= 1) x = x + __shfl_xor_sync(0xffffffffu, x, d);
+  return x;
+#endif
+}
+
+// The 4 k-columns this lane owns.  The order is NOT left-to-right: Triton starts
+// its reduce by folding the high half of the first f32x2 pair into the low half,
+// which scalarises to element 1 as the base product and then 0, 2, 3.  Getting
+// this wrong is worth ~1 ulp on 0.03% of elements -- enough to move tokens.
+__device__ __forceinline__ float dot4_2d(const float (&u)[4],
+                                         const float (&w)[4]) {
+  float acc = u[1] * w[1];
+  acc = fmaf(u[0], w[0], acc);
+  acc = fmaf(u[2], w[2], acc);
+  acc = fmaf(u[3], w[3], acc);
+  return acc;
+}
+
+// The 1-D (l2-norm) reduce differs in its LAST step: because the second f32x2
+// pair was already squared by a `mul.f32x2`, the final combine is an `add.f32x2`
+// of that precomputed product -- an add, not an fma, and with the product first.
+__device__ __forceinline__ float dot4_1d(const float (&u)[4],
+                                         const float (&w)[4]) {
+  float acc = u[1] * w[1];
+  acc = fmaf(u[0], w[0], acc);
+  acc = fmaf(u[2], w[2], acc);
+  acc = (u[3] * w[3]) + acc;
+  return acc;
+}
+
+template <typename T, typename ST, int BV, int KD, int WARPS, int GRP,
+          bool USE_ROWS, bool WRITE_OUT, bool WRITE_STATE>
+__global__ __launch_bounds__(WARPS * 32) void gdn_verify_kernel(
+    const void *__restrict__ A_log_p, int c_alog,
+    const void *__restrict__ dtb_p, int c_dtb,
+    const void *__restrict__ a_p, int c_a, const void *__restrict__ b_p,
+    int c_b, const T *__restrict__ q, const T *__restrict__ k,
+    const T *__restrict__ v, T *__restrict__ o, ST *__restrict__ state,
+    const int *__restrict__ chain, const int *__restrict__ depth,
+    const int *__restrict__ out_slot, const int *__restrict__ init_slot,
+    const int *__restrict__ rows, float scale, int T_rows, int MAXD,
+    int H, int HV, int VD, int stride_chain, long stride_state_slot,
+    float threshold, int NV) {
