+++ b/vllm/v1/spec_decode/tree_gdn.py
@@ -0,0 +1,1082 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Tree-aware Gated-DeltaNet (conv1d + recurrence) for spec-decode tree verify.
+
+Stock vLLM's GDN spec-decode kernels assume the drafted tokens form a linear
+CHAIN: the recurrence carries one register block across ``for i_t in range(T)``
+with no parent indirection, and the conv1d keeps a single sliding window per
+request.  Sibling tree nodes at adjacent flat offsets would therefore pollute
+each other's state.
+
+Both are fixed here by making every node read its PARENT's state instead of the
+previous flat token, exactly as in the chained-flow offline harness
+(``chained_flow.vllm_tree.tree_ssm``).  Two facts make this cheap inside vLLM:
+
+  * vLLM already allocates ``num_speculative_tokens + 1`` mamba state slots per
+    spec request (``gdn_attn.py``: ``block_table[:, :num_spec+1]``) and selects
+    the live one with a per-request integer.  Those slots are exactly the
+    per-node state slots a tree needs -- no new allocation.
+  * The recurrence is written PATH-PARALLEL (one program per (node, head,
+    v-block), each walking its own root->node path from the request's initial
+    state) rather than depth-serial, so there is no intra-kernel ordering
+    requirement and no read/write race on the initial slot.
+
+Slot assignment: with ``num_speculative_tokens = tree_nodes + 1`` there are
+``tree_nodes + 2`` slot columns for ``tree_nodes + 1`` query rows, so the row
+that would otherwise land on the request's *initial* column is shifted by one
+(``_colmap``); the initial state is therefore never overwritten while other
+programs are still reading it.
+"""
+
+from __future__ import annotations
+
+import weakref
+
+import numpy as np
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+# --------------------------------------------------------------------------- #
+#  conv1d over a tree                                                          #
+# --------------------------------------------------------------------------- #
+@triton.jit(do_not_specialize=["T"])
+def _tree_conv_kernel(
+    x_ptr,  # [T, dim]
+    w_ptr,  # [dim, width]
+    bias_ptr,
+    conv_state_ptr,  # [num_slots, dim, state_len]
+    chain_ptr,  # [T, MAXD+1] int32, chain[t,0]=t, clamped at the request root
+    depth_ptr,  # [T] int32
+    out_slot_ptr,  # [T] int32 absolute conv-state slot to write
+    init_slot_ptr,  # [T] int32 absolute conv-state slot holding the history
+    o_ptr,  # [T, dim]
+    T,
+    dim: tl.constexpr,
+    stride_x_tok: tl.int64,
+    stride_w_dim: tl.constexpr,
+    stride_state_slot: tl.int64,
+    stride_state_dim: tl.constexpr,
+    stride_state_tok: tl.constexpr,
+    stride_chain: tl.constexpr,
+    stride_o_tok: tl.int64,
+    HAS_BIAS: tl.constexpr,
+    SILU: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+):
+    t = tl.program_id(1)
+    if t >= T:
+        return
+    feats = tl.program_id(0) * BLOCK_N + tl.arange(0, BLOCK_N)
+    mw = feats < dim
+
+    w0 = tl.load(w_ptr + feats * stride_w_dim + 0, mw, 0.0)
+    w1 = tl.load(w_ptr + feats * stride_w_dim + 1, mw, 0.0)
+    w2 = tl.load(w_ptr + feats * stride_w_dim + 2, mw, 0.0)
+    w3 = tl.load(w_ptr + feats * stride_w_dim + 3, mw, 0.0)
+    if HAS_BIAS:
+        acc = tl.load(bias_ptr + feats, mw, 0.0).to(tl.float32)
+    else:
+        acc = tl.zeros([BLOCK_N], tl.float32)
+
+    d = tl.load(depth_ptr + t)
+    hbase = (
+        conv_state_ptr
+        + tl.load(init_slot_ptr + t).to(tl.int64) * stride_state_slot
+        + feats * stride_state_dim
+    )
+    h0 = tl.load(hbase + 0 * stride_state_tok, mw, 0.0)
+    h1 = tl.load(hbase + 1 * stride_state_tok, mw, 0.0)
+    h2 = tl.load(hbase + 2 * stride_state_tok, mw, 0.0)
+
+    a1 = tl.load(chain_ptr + t * stride_chain + 1).to(tl.int64)
+    a2 = tl.load(chain_ptr + t * stride_chain + 2).to(tl.int64)
+    a3 = tl.load(chain_ptr + t * stride_chain + 3).to(tl.int64)
+    g0 = tl.load(x_ptr + t * stride_x_tok + feats, mw, 0.0)
+    xa1 = tl.load(x_ptr + a1 * stride_x_tok + feats, mw, 0.0)
+    xa2 = tl.load(x_ptr + a2 * stride_x_tok + feats, mw, 0.0)
+    xa3 = tl.load(x_ptr + a3 * stride_x_tok + feats, mw, 0.0)
+    # g(k) = token k steps back along this node's path; fall back to history
+    g1 = tl.where(d >= 1, xa1, h2)
+    g2 = tl.where(d >= 2, xa2, tl.where(d >= 1, h2, h1))
+    g3 = tl.where(d >= 3, xa3, tl.where(d >= 2, h2, tl.where(d >= 1, h1, h0)))
+
+    acc += g3 * w0
+    acc += g2 * w1
+    acc += g1 * w2
+    acc += g0 * w3
+    if SILU:
+        acc = acc / (1 + tl.exp(-acc))
+    tl.store(o_ptr + t * stride_o_tok + feats, acc, mask=mw)
+
+    obase = (
+        conv_state_ptr
+        + tl.load(out_slot_ptr + t).to(tl.int64) * stride_state_slot
+        + feats * stride_state_dim
+    )
+    tl.store(obase + 0 * stride_state_tok, g2, mask=mw)
+    tl.store(obase + 1 * stride_state_tok, g1, mask=mw)
+    tl.store(obase + 2 * stride_state_tok, g0, mask=mw)
+
+
+@torch.inference_mode()
+def tree_causal_conv1d(x, conv_state, weight, bias, meta, activation="silu"):
+    """x: [T, dim] pre-conv.  Returns [T, dim] post-conv (+ silu)."""
+    T, dim = x.shape
+    assert weight.shape[1] == 4, "tree conv currently assumes conv width 4"
+    o = torch.empty_like(x)
+    BLOCK_N = 256
+    _tree_conv_kernel[(triton.cdiv(dim, BLOCK_N), T)](
+        x,
+        weight,
+        bias if bias is not None else x,
+        conv_state,
+        meta.chain,
+        meta.depth,
+        meta.out_slot,
+        meta.init_slot,
+        o,
+        T,
+        dim,
+        x.stride(0),
+        weight.stride(0),
+        conv_state.stride(0),
+        conv_state.stride(1),
+        conv_state.stride(2),
+        meta.chain.stride(0),
+        o.stride(0),
+        bias is not None,
+        activation == "silu",
+        BLOCK_N,
+        num_warps=4,
+        num_stages=1,
+    )
+    return o
+
+
+# --------------------------------------------------------------------------- #
+#  gated delta recurrence over a tree (path-parallel)                          #
+# --------------------------------------------------------------------------- #
+@triton.jit(do_not_specialize=["T", "MAXD"])
+def _tree_gdn_kernel(
+    A_log,
+    a,
+    b,
+    dt_bias,
+    q,
+    k,
+    v,
+    o,
+    state,  # [num_slots, HV, V, K]
+    chain,  # [T, MAXD+1]
+    depth,  # [T]
+    out_slot,  # [T]
+    init_slot,  # [T]
+    rows,  # [T] optional query-row indirection (deferred state pass)
+    scale,
+    T,
+    MAXD,
+    H: tl.constexpr,
+    HV: tl.constexpr,
+    K: tl.constexpr,
+    V: tl.constexpr,
+    BK: tl.constexpr,
+    BV: tl.constexpr,
+    stride_state_slot: tl.int64,
+    stride_chain: tl.constexpr,
+    THRESHOLD: tl.constexpr,
+    USE_QK_L2NORM: tl.constexpr,
+    USE_ROWS: tl.constexpr,
+    WRITE_OUT: tl.constexpr,
+    WRITE_STATE: tl.constexpr,
+):
+    i_v, i_hv, t = tl.program_id(0), tl.program_id(1), tl.program_id(2)
+    if t >= T:
+        return
+    if USE_ROWS:
+        t = tl.load(rows + t).to(tl.int32)
+    i_h = i_hv // (HV // H)
+    o_k = tl.arange(0, BK)
+    o_v = i_v * BV + tl.arange(0, BV)
+    mask_k = o_k < K
+    mask_v = o_v < V
+    mask_h = mask_v[:, None] & mask_k[None, :]
+
+    A_log_val = tl.load(A_log + i_hv).to(tl.float32)
+    dt_bias_val = tl.load(dt_bias + i_hv).to(tl.float32)
+
+    p_h0 = (
+        state
+        + tl.load(init_slot + t).to(tl.int64) * stride_state_slot
+        + i_hv * V * K
+        + o_v[:, None] * K
+        + o_k[None, :]
+    )
+    b_h = tl.load(p_h0, mask=mask_h, other=0).to(tl.float32)
+
+    d_t = tl.load(depth + t)
+    # walk root -> node: apply ancestors from the deepest offset down to 0
+    for kk in range(MAXD, -1, -1):
+        active = kk <= d_t
+        idx = tl.where(active, kk, 0)
+        anc = tl.load(chain + t * stride_chain + idx).to(tl.int64)
+        b_k = tl.load(k + (anc * H + i_h) * K + o_k, mask=mask_k, other=0).to(
+            tl.float32
+        )
+        b_v = tl.load(v + (anc * HV + i_hv) * V + o_v, mask=mask_v, other=0).to(
+            tl.float32
+        )
+        if USE_QK_L2NORM:
+            b_k = b_k * tl.rsqrt(tl.sum(b_k * b_k) + 1e-6)
+        x = tl.load(a + anc * HV + i_hv).to(tl.float32) + dt_bias_val
+        softplus_x = tl.where(x <= THRESHOLD, tl.log(1 + tl.exp(x)), x)
+        b_g = -tl.exp(A_log_val) * softplus_x
+        b_beta = tl.sigmoid(tl.load(b + anc * HV + i_hv).to(tl.float32))
+        h2 = b_h * tl.exp(b_g)
+        v2 = b_v - tl.sum(h2 * b_k[None, :], 1)
+        v2 = v2 * b_beta
+        h2 = h2 + v2[:, None] * b_k[None, :]
+        b_h = tl.where(active, h2, b_h)
+
+    if WRITE_OUT:
+        b_q = tl.load(q + (t * H + i_h) * K + o_k, mask=mask_k, other=0).to(tl.float32)
+        if USE_QK_L2NORM:
+            b_q = b_q * tl.rsqrt(tl.sum(b_q * b_q) + 1e-6)
+        b_q = b_q * scale
+        b_o = tl.sum(b_h * b_q[None, :], 1)
+        p_o = o + (t * HV + i_hv) * V + o_v
+        tl.store(p_o, b_o.to(p_o.dtype.element_ty), mask=mask_v)
+
+    if WRITE_STATE:
+        p_ht = (
+            state
+            + tl.load(out_slot + t).to(tl.int64) * stride_state_slot
+            + i_hv * V * K
+            + o_v[:, None] * K
+            + o_k[None, :]
+        )
+        tl.store(p_ht, b_h.to(p_ht.dtype.element_ty), mask=mask_h)
+
+
+# --------------------------------------------------------------------------- #
+#  CF_GDN_DEFER: don't write the per-node recurrent state during verify         #
+# --------------------------------------------------------------------------- #
+# TRAFFIC.  The recurrent state is [HV, V, K] fp32 = 32*128*128*4 = 2.00 MiB PER
+# SLOT, and tree verify uses one slot per NODE.  At the 41-node shipping shape
+# that is 41 x 24 GDN layers x (read + write) = 3.84 GiB of fp32 state traffic
+# per forward -- against a model whose entire fp16 weight set is 8.41 GiB.  The
+# WRITE half (1.92 GiB, and unlike the read it is 41 DISTINCT 2 MiB regions, so
+# it cannot be served from L2 and it evicts everything the following GEMMs want)
+# is pure waste: verification keeps exactly ONE node's state, the accepted leaf's,
+# and which one that is isn't known until after the forward has been sampled.
+#
+# So under CF_GDN_DEFER=1 the verify launch computes `o` and drops `b_h` on the
+# floor (WRITE_STATE=False), and `_tree_postprocess` re-runs the SAME kernel for
+# the S accepted-leaf rows only (USE_ROWS=True, WRITE_OUT=False), materialising
+# 1 slot per request instead of 41.
+#
+# BIT-EXACTNESS.  This is the target model's own math, so nothing here is allowed
+# to move a ulp.  Nothing does: the arithmetic that produces `b_h` and `b_o` is
+# character-for-character the code that ran before -- the only change is two
+# constexpr guards around the two final `tl.store`s -- and the deferred pass
+# re-executes that same op sequence on the same inputs, so the state it writes is
+# the same bits the first pass would have written.
+#
+# STALENESS TRAP.  The verify forward is a FULL cudagraph (CF_TREE_FULLCG=1), so
+# on a replay step the layer's python never runs and the stash below is whatever
+# CAPTURE put there -- which is correct, because a replay writes its intermediates
+# into exactly the addresses capture recorded.  But ~1% of steps dispatch
+# PIECEWISE and DO run the python, allocating fresh tensors.  Stashing those and
+# then reading them back on a later REPLAY step would be a use-after-free.  Hence
+# two stashes: `_STASH_GRAPH` (written while capturing, permanently valid) and
+# `_STASH_EAGER` (written by live python, valid for exactly ONE postprocess, then
+# invalidated).  `_tree_postprocess` prefers the eager stash when it is armed.
+#
+# MEMORY TRAP (the second one).  A stash entry pins this layer's k/v/a/b.  Under
+# capture those are CUDAGRAPH-POOL allocations, and pinning them stops a later
+# capture from reusing the pool blocks -- so keying the stash by `id(layout)`,
+# with a fresh layout object per step, grew the graph pool by one full set of GDN
+# activations PER CAPTURED STEP (measured at 4B: the cudagraph memory estimate
+# went 0.548 -> 0.519 of the budget, KV cache 31291 -> 28846 tokens; at 27B it was
+# a hard OOM before the KV cache was even allocated).  So the graph stash is keyed
+# WEAKLY on the layout: the persistent static layout keeps its entries alive for
+# as long as it is itself alive, and the per-step dynamic layouts drop theirs the
+# moment the step is over.
+_DEFER: bool | None = None
+_DEFER_MAXROWS = 64
+_STASH_GRAPH: "weakref.WeakKeyDictionary" = weakref.WeakKeyDictionary()
+_STASH_EAGER: "weakref.WeakKeyDictionary" = weakref.WeakKeyDictionary()
+_EAGER_LAYOUT = None
+_DBG_N = 0
+_EAGER_ARMED = False
+
+
+def defer_state() -> bool:
+    """CF_GDN_DEFER=1: skip the per-node state write in the verify forward."""
+    global _DEFER, _DEFER_MAXROWS
+    if _DEFER is None:
+        import os as _os
+
+        _DEFER = _os.environ.get("CF_GDN_DEFER", "0") == "1"
+        _DEFER_MAXROWS = int(_os.environ.get("CF_GDN_DEFER_MAXROWS", "0") or 0) or 64
+    return _DEFER
+
+
+_REF_BV = 32  # the shipping geometry; the CHECK reference
+_TRITON_BV: int | None = None
+
+
+def _triton_bv() -> int:
+    global _TRITON_BV
+    if _TRITON_BV is None:
+        import os as _os
+
+        _TRITON_BV = int(_os.environ.get("CF_GDN_BV", "0") or 0) or 32
+    return _TRITON_BV
+
+
+def defer_rows(T: int) -> bool:
+    """Row-count gate.  A stash entry pins this layer's k/v for as long as it
+    lives, and under capture those are cudagraph-pool blocks -- so deferring at
+    EVERY captured batch size would grow the pool by one set of GDN activations
+    per captured shape (measured: KV cache 31291 -> 29227 tokens at 4B, OOM at
+    27B).  vLLM captures S = 1..12 requests, i.e. T = 41..492 rows, but the
+    shipping config is batch 1; capping at 64 rows keeps the retention to a single
+    shape (~12 MiB at 4B) and leaves every larger shape on the original path,
+    where the state write happens in the verify pass exactly as before."""
+    return defer_state() and T <= _DEFER_MAXROWS
+
+
+def step_reset() -> None:
+    """Drop the eager stash at the START of a step.
+
+    MEMORY.  A stash entry pins this layer's q/k/v/a/b for as long as it lives.
+    `_tree_postprocess` normally consumes and clears it within the same step, but
+    the memory-PROFILING forward never reaches postprocess -- so without this the
+    profiler saw ~24 (4B) / 48 (27B) layers' worth of activations still reachable,
+    under-reported the free memory, and shrank the KV cache (measured: 31291 ->
+    28846 tokens at 4B, and a hard OOM at 27B).  Both callers run on the host once
+    per step, before the forward.
+    """
+    global _EAGER_ARMED, _EAGER_LAYOUT
+    _STASH_EAGER.clear()
+    _EAGER_ARMED = False
+    _EAGER_LAYOUT = None
+
+
+def _stash(entry: dict) -> None:
+    global _EAGER_ARMED
+    # KEY.  Per (layer, layout): `state.data_ptr()` alone is NOT unique per layer
+    # (vLLM hands several GDN layers views into one mamba cache allocation), and a
+    # capture at a second tree shape would otherwise evict the first shape's
+    # entries -- which is exactly what leaves states unwritten at replay.
+    global _EAGER_LAYOUT
+    lay = entry["layout"]
+    # `o` is dead in the deferred pass (WRITE_OUT=False); pointing it at `state`
+    # keeps a whole [T,HV,V] activation per layer from being pinned by the stash.
+    entry = dict(entry, o=entry["state"])
+    capturing = torch.cuda.is_available() and torch.cuda.is_current_stream_capturing()
+    stash = _STASH_GRAPH if capturing else _STASH_EAGER
+    per_layer = stash.get(lay)
+    if per_layer is None:
+        per_layer = {}
+        stash[lay] = per_layer
+    per_layer[entry["layer_key"]] = entry
+    if not capturing:
+        _EAGER_ARMED = True
+        _EAGER_LAYOUT = lay
+
+
+def _launch(
+    e: dict, *, rows, n_rows: int, write_out: bool, write_state: bool
+) -> None:
+    meta = e["meta"]
+    # CF_GDN_CUDA: raw-CUDA drop-in, BIT-EXACT (verified element-for-element in
+    # both `o` and the written state).  Same kernel serves both launches.
+    from vllm.v1.spec_decode import tree_gdn_verify as _cu
+
+    use_cuda = (
+        _cu.enabled()
+        and _cu.route(rows is None)   # rows is None => the verify pass
+        and _cu.supported(e, meta)
+    )
+
+    def _go():
+        if use_cuda:
+            _cu.run(e, rows=rows, n_rows=n_rows, write_out=write_out,
+                    write_state=write_state)
+        else:
+            _launch_triton(e, rows=rows, n_rows=n_rows, write_out=write_out,
+                           write_state=write_state)
+
+    # CF_GDN_CUDA_CHECK: device-side element tally of WHATEVER geometry/kernel is
+    # enabled against the untouched reference arithmetic -- the Triton kernel at
+    # BV=32, i.e. exactly what shipped before any of this.  It therefore validates
+    # CF_GDN_BV just as well as CF_GDN_CUDA, and it runs under cudagraph replay
+    # because nothing here reads a predicate back to the host.
+    if _cu.check_mode() and (use_cuda or e["BV"] != _REF_BV):
+        ref_e = dict(e, BV=_REF_BV, NV=triton.cdiv(e["V"], _REF_BV))
+        if write_out:
+            ref_o = torch.empty_like(e["o"])
+            _launch_triton(dict(ref_e, o=ref_o), rows=rows, n_rows=n_rows,
+                           write_out=True, write_state=False)
+        if write_state and rows is not None:
+            # Snapshot ONLY the destination slots (one per request), not the whole
+            # multi-GiB mamba cache: run the reference, save what it wrote, put the
+            # slot back, then run the real kernel and diff.
+            dst = meta.out_slot.index_select(0, rows.to(torch.int64)).to(torch.int64)
+            before = e["state"].index_select(0, dst).clone()
+            _launch_triton(ref_e, rows=rows, n_rows=n_rows, write_out=False,
+                           write_state=True)
+            ref_s = e["state"].index_select(0, dst).clone()
+            e["state"].index_copy_(0, dst, before)
+        _go()
+        if write_out:
+            _cu.tally(e["o"], ref_o)
+        if write_state and rows is not None:
+            _cu.tally(e["state"].index_select(0, dst), ref_s)
+        return
+    _go()
+
+
+def _launch_triton(
+    e: dict, *, rows, n_rows: int, write_out: bool, write_state: bool
+) -> None:
+    meta = e["meta"]
+    _tree_gdn_kernel[(e["NV"], e["HV"], n_rows)](
+        e["A_log"],
+        e["a"],
+        e["b"],
+        e["dt_bias"],
+        e["q"],
+        e["k"],
+        e["v"],
+        e["o"],
+        e["state"],
+        meta.chain,
+        meta.depth,
+        meta.out_slot,
+        meta.init_slot,
+        rows if rows is not None else e["o"],
+        e["scale"],
+        n_rows,
+        meta.maxd,
+        e["H"],
+        e["HV"],
+        e["K"],
+        e["V"],
+        e["BK"],
+        e["BV"],
+        e["state"].stride(0),
+        meta.chain.stride(0),
+        20.0,
+        e["use_qk_l2norm"],
+        rows is not None,
+        write_out,
+        write_state,
+        num_warps=1,
+        num_stages=1,
+    )
+
+
+@torch.inference_mode()
+def disarm_deferred() -> int:
+    """Postprocess could not identify an accepted leaf for the live layout.
+
+    If live python stashed anything this step it must still be flushed -- writing
+    every node's state is wasteful but correct, and silently dropping it would
+    leave the next step reading a rejected sibling's state.
+    """
+    if not _EAGER_ARMED:
+        return 0
+    return finalize_deferred(None)
+
+
+@torch.inference_mode()
+def finalize_deferred(rows: torch.Tensor | None, layout=None) -> int:
+    """Materialise the deferred recurrent state.
+
+    ``rows`` holds the global query row of each request's ACCEPTED LEAF; passing
+    ``None`` falls back to writing every node's state (correct, just as expensive
+    as not deferring at all) and exists so a step that somehow reaches
+    postprocess without an accepted path can never leave stale state behind.
+    """
+    global _EAGER_ARMED
+    eager = _EAGER_ARMED
+    stash = _STASH_EAGER if eager else _STASH_GRAPH
+    _EAGER_ARMED = False
+    if layout is None:
+        layout = _EAGER_LAYOUT if eager else None
+    entries = stash.get(layout, {}) if layout is not None else {}
+    n = 0
+    for e in entries.values():
+        if rows is None:
+            _launch(
+                e, rows=None, n_rows=e["T"], write_out=False, write_state=True
+            )
+        else:
+            _launch(
+                e,
+                rows=rows,
+                n_rows=int(rows.numel()),
+                write_out=False,
+                write_state=True,
+            )
+        n += 1
+    if eager:
+        _STASH_EAGER.clear()
+    global _DBG_N
+    if _DBG_N < 6 and __import__("os").environ.get("CF_GDN_DEFER_DEBUG") == "1":
+        _DBG_N += 1
+        # `.tolist()` is a host sync -- debug flag only.
+        print(
+            f"[gdn-defer] finalize: stash={'eager' if eager else 'graph'} "
+            f"layouts={len(stash)} entries={len(entries)} launched={n} "
+            f"rows={None if rows is None else rows.tolist()}",
+            flush=True,
+        )
+    return n
+
+
+@torch.inference_mode()
+def tree_gated_delta_rule_update(
+    A_log,
+    a,
+    b,
+    dt_bias,
+    q,
+    k,
+    v,
+    state,
+    meta,
+    scale=None,
+    use_qk_l2norm=True,
+    layout=None,
+    layer_key=None,
+):
+    """q,k: [1,T,H,K]  v: [1,T,HV,V]  a,b: [T,HV].  Returns o: [T,HV,V]."""
+    T = q.shape[1]
+    H, Kd = q.shape[2], q.shape[3]
+    HV, Vd = v.shape[2], v.shape[3]
+    if scale is None:
+        scale = Kd**-0.5
+    BK = triton.next_power_of_2(Kd)
+    # CF_GDN_BV: v-rows per program.  Triton's layout for the [BV,BK] state tile
+    # is sizePerThread=[1,4] x threadsPerWarp=[1,32], so a thread holds 4*BV live
+    # floats -- BV=32 costs 210 registers and caps the kernel at 8 warps/SM
+    # (measured occupancy 15.35%).  The reduction runs along K, which BV does not
+    # touch, so shrinking BV is BIT-EXACT: verified 0 differing elements, and
+    # worth 69.98 -> 48.59 us/layer at BV=16.  Default keeps the original 32.
+    BV = min(triton.next_power_of_2(Vd), _triton_bv())
+    NV = triton.cdiv(Vd, BV)
+    o = torch.empty(T, HV, Vd, device=q.device, dtype=q.dtype)
+    defer = defer_rows(T)
+    e = {
+        "layer_key": layer_key if layer_key is not None else state.data_ptr(),
+        "layout": layout,
+        "A_log": A_log,
+        "a": a.contiguous(),
+        "b": b.contiguous(),
+        "dt_bias": dt_bias,
+        "q": q.contiguous(),
+        "k": k.contiguous(),
+        "v": v.contiguous(),
+        "o": o,
+        "state": state,
+        "meta": meta,
+        "scale": scale,
+        "T": T,
+        "H": H,
+        "HV": HV,
+        "K": Kd,
+        "V": Vd,
+        "BK": BK,
+        "BV": BV,
+        "NV": NV,
+        "use_qk_l2norm": use_qk_l2norm,
+    }
+    # CF_GDN_FACTOR: the shared-root factorisation replaces the whole
+    # path-parallel scan for the OUTPUT half.  It never writes state, so it is
+    # only legal on top of CF_GDN_DEFER, which materialises the accepted leaf's
+    # state afterwards with the Triton kernel below (bit-exact, unaffected).
+    from vllm.v1.spec_decode import tree_gdn_factor as _fac
+
+    used_factor = False
+    if defer and _fac.enabled():
+        if _fac.supported(
+            layout=layout, meta=meta, q=e["q"], k=e["k"], v=e["v"], o=o,
+            state=state, Kd=Kd, Vd=Vd,
+        ):
+            _fac.run(
+                A_log=A_log, dt_bias=dt_bias, a=e["a"], b=e["b"], q=e["q"],
+                k=e["k"], v=e["v"], o=o, state=state, meta=meta, layout=layout,
+                scale=scale, H=H, HV=HV, Vd=Vd,
+            )
+            used_factor = True
+            if _fac.check_mode():
+                ref = torch.empty_like(o)
+                e2 = dict(e, o=ref)
+                _launch(e2, rows=None, n_rows=T, write_out=True, write_state=False)
+                _fac.tally(o, ref)
+    if not used_factor:
+        _launch(e, rows=None, n_rows=T, write_out=True, write_state=not defer)
+    if defer:
+        _stash(e)
+    return o
+
+
+# --------------------------------------------------------------------------- #
+#  LEVEL-SYNCHRONOUS tree recurrence (O(nodes) work)                           #
+#  The path-parallel kernel above re-walks each node's whole ancestor path, so  #
+#  its work is O(nodes x depth).  Here we launch ONCE PER DEPTH: every node     #
+#  reads its PARENT's already-written state slot and applies exactly its own    #
+#  update.  A level only reads slots written by strictly earlier levels (and    #
+#  out_slot is unique per row and never equals an init slot), so there is no    #
+#  race; same-stream launch order provides the barrier.                         #
+# --------------------------------------------------------------------------- #
+@triton.jit(do_not_specialize=["NROW"])
+def _tree_gdn_level_kernel(
+    A_log, a, b, dt_bias, q, k, v, o, state,
+    rows,          # [NROW] global query-row index of each node at this depth
+    parent_slot,   # [T] state slot holding this row's PARENT state
+    out_slot,      # [T]
+    scale, NROW,
+    H: tl.constexpr, HV: tl.constexpr, K: tl.constexpr, V: tl.constexpr,
+    BK: tl.constexpr, BV: tl.constexpr,
+    stride_state_slot: tl.int64,
+    THRESHOLD: tl.constexpr, USE_QK_L2NORM: tl.constexpr,
+):
+    i_v, i_hv, j = tl.program_id(0), tl.program_id(1), tl.program_id(2)
+    if j >= NROW:
+        return
+    t = tl.load(rows + j).to(tl.int64)
+    i_h = i_hv // (HV // H)
+    o_k = tl.arange(0, BK)
+    o_v = i_v * BV + tl.arange(0, BV)
+    mask_k = o_k < K
+    mask_v = o_v < V
+    mask_h = mask_v[:, None] & mask_k[None, :]
+
+    A_log_val = tl.load(A_log + i_hv).to(tl.float32)
+    dt_bias_val = tl.load(dt_bias + i_hv).to(tl.float32)
+    p_h0 = (state + tl.load(parent_slot + t).to(tl.int64) * stride_state_slot
+            + i_hv * V * K + o_v[:, None] * K + o_k[None, :])
+    b_h = tl.load(p_h0, mask=mask_h, other=0).to(tl.float32)
+
+    b_k = tl.load(k + (t * H + i_h) * K + o_k, mask=mask_k, other=0).to(tl.float32)
+    b_v = tl.load(v + (t * HV + i_hv) * V + o_v, mask=mask_v, other=0).to(tl.float32)
+    if USE_QK_L2NORM:
+        b_k = b_k * tl.rsqrt(tl.sum(b_k * b_k) + 1e-6)
+    x = tl.load(a + t * HV + i_hv).to(tl.float32) + dt_bias_val
+    softplus_x = tl.where(x <= THRESHOLD, tl.log(1 + tl.exp(x)), x)
+    b_g = -tl.exp(A_log_val) * softplus_x
+    b_beta = tl.sigmoid(tl.load(b + t * HV + i_hv).to(tl.float32))
+    b_h = b_h * tl.exp(b_g)
+    b_v = b_v - tl.sum(b_h * b_k[None, :], 1)
+    b_v = b_v * b_beta
+    b_h = b_h + b_v[:, None] * b_k[None, :]
+
+    b_q = tl.load(q + (t * H + i_h) * K + o_k, mask=mask_k, other=0).to(tl.float32)
+    if USE_QK_L2NORM:
+        b_q = b_q * tl.rsqrt(tl.sum(b_q * b_q) + 1e-6)
+    b_q = b_q * scale
+    b_o = tl.sum(b_h * b_q[None, :], 1)
+    p_o = o + (t * HV + i_hv) * V + o_v
+    tl.store(p_o, b_o.to(p_o.dtype.element_ty), mask=mask_v)
+    p_ht = (state + tl.load(out_slot + t).to(tl.int64) * stride_state_slot
+            + i_hv * V * K + o_v[:, None] * K + o_k[None, :])
+    tl.store(p_ht, b_h.to(p_ht.dtype.element_ty), mask=mask_h)
+
+
+@torch.inference_mode()
+def tree_gated_delta_rule_update_level(
+    A_log, a, b, dt_bias, q, k, v, state, meta, scale=None, use_qk_l2norm=True
+):
+    """O(nodes) level-synchronous twin of tree_gated_delta_rule_update."""
+    T = q.shape[1]
+    H, Kd = q.shape[2], q.shape[3]
+    HV, Vd = v.shape[2], v.shape[3]
+    if scale is None:
+        scale = Kd**-0.5
+    BK = triton.next_power_of_2(Kd)
+    BV = min(triton.next_power_of_2(Vd), 32)
+    NV = triton.cdiv(Vd, BV)
+    o = torch.empty(T, HV, Vd, device=q.device, dtype=q.dtype)
+    qc, kc, vc, ac, bc = (q.contiguous(), k.contiguous(), v.contiguous(),
+                          a.contiguous(), b.contiguous())
+    for rows in meta.levels:
+        n = rows.numel()
+        if n == 0:
+            continue
+        _tree_gdn_level_kernel[(NV, HV, n)](
+            A_log, ac, bc, dt_bias, qc, kc, vc, o, state,
+            rows, meta.parent_slot, meta.out_slot, scale, n,
+            H, HV, Kd, Vd, BK, BV, state.stride(0), 20.0, use_qk_l2norm,
+            num_warps=1, num_stages=1,
+        )
+    return o
+
+
+# --------------------------------------------------------------------------- #
+#  per-step metadata                                                           #
+# --------------------------------------------------------------------------- #
+class TreeGDNMeta:
+    """Per-layer slot tensors + the layer-independent tree layout."""
+
+    __slots__ = (
+        "chain",
+        "depth",
+        "out_slot",
+        "init_slot",
+        "parent_slot",
+        "levels",
+        "maxd",
+        "num_rows",
+    )
+
+
+class TreeGDNLayout:
+    """Layer-INDEPENDENT part of the tree layout (built once per step).
+
+    NOTE: every GDN layer has its OWN mamba block ids (``spec_state_indices``
+    differs per layer), so only the ancestry/column arithmetic can be shared;
+    the absolute slot ids must be gathered per layer.
+    """
+
+    __slots__ = (
+        "__weakref__",  # the CF_GDN_DEFER stash keys on this object WEAKLY
+        "chain", "depth", "seq", "loc", "maxd", "num_rows", "levels", "hoist",
+        # [S] global query row of each spec request's row 0 (CF_GDN_DEFER),
+        # plus the int32 twins + row counts the CF_GDN_FACTOR kernel indexes with
+        "row_start", "row_start32", "row_count", "n_max",
+        # FULL-cudagraph path only: pinned staging for the per-step refill of the
+        # two ancestry tensors (see `get_static_layout`).
+        "pin_chain", "pin_depth", "static",
+        # CF_ASYNC_SPEC: `depth` is a constant of the tree SHAPE, so the GPU fill path
+        # writes it once instead of every step (see `fill_static_layout_gpu`).
+        "_cf_depth_filled",
+    )
+
+
+def _prewarm_extensions() -> None:
+    """Build the CF_GDN_FACTOR extension HERE, on the host, before any capture.
+
+    Both callers run from `_prepare_inputs` / `synthetic_fill`, i.e. strictly
+    outside the cudagraph capture region -- which is where a first-touch ninja
+    build and a `cudaFuncSetAttribute` belong.
+    """
+    if defer_state():
+        from vllm.v1.spec_decode import tree_gdn_factor as _fac
+        from vllm.v1.spec_decode import tree_gdn_verify as _cu
+
+        _fac.enabled()
+        _cu.enabled()
+
+
+def _layout_np(
+    *,
+    parents_np: np.ndarray,
+    depths_np: np.ndarray,
+    num_draft_tokens: np.ndarray,
+    spec_req_order: np.ndarray,
+):
+    """Host-side flattening shared by the per-step and the persistent layouts.
+
+    Returns ``(par, dep, seq, loc, chain)`` as numpy arrays.  ``chain[t, k]`` is
+    the row reached by walking ``k`` parents up from row ``t`` (clamped at the
+    request root), which is what both triton kernels index.
+    """
+    rows_parent: list[int] = []
+    rows_depth: list[int] = []
+    rows_seq: list[int] = []
+    rows_local: list[int] = []
+    row_start: list[int] = []
+    starts = np.zeros(len(num_draft_tokens) + 1, dtype=np.int64)
+    np.cumsum(num_draft_tokens, out=starts[1:])
+    base = 0
+    for s, r in enumerate(spec_req_order):
+        row_start.append(base)
+        r = int(r)
+        n = int(num_draft_tokens[r])
+        off = int(starts[r])
+        p = parents_np[off : off + n]
+        d = depths_np[off : off + n]
+        rows_parent.append(-1)
+        rows_depth.append(0)
+        rows_seq.append(s)
+        rows_local.append(0)
+        for i in range(n):
+            rows_parent.append(base + (0 if int(p[i]) < 0 else 1 + int(p[i])))
+            rows_depth.append(1 + int(d[i]))
+            rows_seq.append(s)
+            rows_local.append(1 + i)
+        base += n + 1
+    T = len(rows_parent)
+    par = np.asarray(rows_parent, dtype=np.int64)
+    dep = np.asarray(rows_depth, dtype=np.int64)
+    maxd = int(dep.max())
+
+    self_idx = np.arange(T, dtype=np.int64)
+    par_idx = np.where(par < 0, self_idx, par)
+    # width >= 4: the width-4 conv1d kernel always reads chain[:, 0..3]
+    chain_w = max(maxd, 3) + 1
+    chain = np.empty((T, chain_w), dtype=np.int32)
+    chain[:, 0] = self_idx
+    cur = self_idx
+    for kk in range(1, chain_w):
+        cur = par_idx[cur]
+        chain[:, kk] = cur
+    return (
+        par,
+        dep,
+        np.asarray(rows_seq, dtype=np.int64),
+        np.asarray(rows_local, dtype=np.int64),
+        chain,
+        maxd,
+        np.asarray(row_start, dtype=np.int64),
+    )
+
+
+# --------------------------------------------------------------------------- #
+#  PERSISTENT layout for the FULL-cudagraph tree path                          #
+# --------------------------------------------------------------------------- #
+# A cudagraph bakes the ADDRESS of every tensor its kernels read.  The per-step
+# `build_gdn_layout` allocates fresh tensors, so a graph captured against one
+# step's layout would read freed/reused memory on every later replay -- silently
+# wrong, no crash.  Under CF_TREE_FULLCG the layout is therefore a module-level
+# singleton keyed on (S, N, maxd, device), allocated once and REFILLED IN PLACE.
+#
+# `seq` and `loc` are pure functions of (S, N) and never change.  `depth` and
+# `chain` depend on the tree shape and are refilled from numpy through pinned
+# staging buffers (T is 17 at batch 1 -- the cost is noise).
+_LAYOUT_CACHE: dict[tuple, TreeGDNLayout] = {}
+
+
+def get_static_layout(
+    *, S: int, N: int, maxd: int, device: torch.device
+) -> TreeGDNLayout:
+    _prewarm_extensions()
+    key = (int(S), int(N), int(maxd), str(device))
+    lay = _LAYOUT_CACHE.get(key)
+    if lay is not None:
+        return lay
+    # See `tree_state.get_static_step`: allocate outside inference mode so the
+    # buffers stay refillable from both the capture path and the step path.
+    with torch.inference_mode(False):
+        return _alloc_static_layout(key, S, N, maxd, device)
+
+
+def _alloc_static_layout(key, S: int, N: int, maxd: int, device) -> TreeGDNLayout:
+    T = S * (N + 1)
+    chain_w = max(maxd, 3) + 1
+    lay = TreeGDNLayout()
+    lay.static = True
+    lay.chain = torch.zeros((T, chain_w), dtype=torch.int32, device=device)
+    lay.depth = torch.zeros(T, dtype=torch.int32, device=device)
+    lay.seq = torch.from_numpy(
+        np.repeat(np.arange(S, dtype=np.int64), N + 1)
+    ).to(device)
+    lay.loc = torch.from_numpy(
+        np.tile(np.arange(N + 1, dtype=np.int64), S)
+    ).to(device)
+    lay.maxd = maxd
+    lay.num_rows = T
+    lay.levels = []  # only the (UNUSED) level-synchronous kernel reads these
+    lay.hoist = None
+    rs = np.arange(S, dtype=np.int64) * (N + 1)
+    lay.row_start = torch.from_numpy(rs).to(device)
+    lay.row_start32 = torch.from_numpy(rs.astype(np.int32)).to(device)
+    lay.row_count = torch.full((S,), N + 1, dtype=torch.int32, device=device)
+    lay.n_max = N + 1
+    lay.pin_chain = torch.empty((T, chain_w), dtype=torch.int32, pin_memory=True)
+    lay.pin_depth = torch.empty(T, dtype=torch.int32, pin_memory=True)
+    lay._cf_depth_filled = False
+    _LAYOUT_CACHE[key] = lay
+    return lay
+
+
+def fill_static_layout(
+    lay: TreeGDNLayout,
+    *,
+    parents_np: np.ndarray,
+    depths_np: np.ndarray,
+    num_draft_tokens: np.ndarray,
+    spec_req_order: np.ndarray,
+) -> None:
+    """Refill a persistent layout IN PLACE for the current step."""
+    _, dep, _, _, chain, maxd, _ = _layout_np(
+        parents_np=parents_np,
+        depths_np=depths_np,
+        num_draft_tokens=num_draft_tokens,
+        spec_req_order=spec_req_order,
+    )
+    assert maxd == lay.maxd, f"tree GDN static layout maxd {maxd} != {lay.maxd}"
+    assert chain.shape == tuple(lay.chain.shape), (
+        f"tree GDN static layout chain {chain.shape} != {tuple(lay.chain.shape)}"
+    )
+    lay.pin_chain.copy_(torch.from_numpy(chain))
+    lay.pin_depth.copy_(torch.from_numpy(dep.astype(np.int32)))
+    lay.chain.copy_(lay.pin_chain, non_blocking=True)
+    lay.depth.copy_(lay.pin_depth, non_blocking=True)
+    # TRAP: `layer_meta` caches the layer-independent slot arithmetic on
+    # `lay.hoist`.  With a PERSISTENT layout that cache would otherwise survive
+    # across steps and every eager/PIECEWISE step after the first would reuse
+    # step 1's slot tensors.  Clearing is also correct under capture: the hoist
+    # ops execute during capture and re-execute at replay into the same
+    # addresses, so the graph recomputes them from the persistent
+    # `num_accepted` buffer.
+    lay.hoist = None
+    step_reset()
+
+
+def fill_static_layout_gpu(lay: TreeGDNLayout, *, depths_np: np.ndarray) -> None:
+    """Finish a persistent layout whose ``chain`` was already written ON THE DEVICE.
+
+    ``depth`` is ``1 + node depth`` with a leading 0 for the committed query row -- a pure
+    function of the tree SHAPE, so it is constant across steps and is filled exactly once.
+    ``chain`` is the only genuinely per-step field, and `tree_state.fill_static_step_gpu`
+    has already copied it in from the device walk, so there is nothing here that needs the
+    parents on the host.
+    """
+    if not getattr(lay, "_cf_depth_filled", False):
+        S = lay.row_start.shape[0]
+        N = lay.num_rows // S - 1
+        d = np.zeros((S, N + 1), dtype=np.int32)
+        d[:, 1:] = 1 + np.asarray(depths_np, dtype=np.int32).reshape(S, N)
+        lay.pin_depth.copy_(torch.from_numpy(d.reshape(-1)))
+        lay.depth.copy_(lay.pin_depth, non_blocking=True)
+        lay._cf_depth_filled = True
