+# ---------------------------------------------------------------------------
+#  TREE verify (chained-flow fork)
+# ---------------------------------------------------------------------------
+@triton.jit(do_not_specialize=["max_spec_len", "max_nodes"])
+def tree_greedy_descent_kernel(
+    output_token_ids_ptr,  # [batch, max_spec_len + 1]
+    accepted_path_ptr,  # [batch, max_spec_len]  node indices, -1 padded
+    accepted_len_ptr,  # [batch]
+    cu_num_draft_tokens_ptr,  # [batch]
+    cu_num_sampled_tokens_ptr,  # [batch]
+    draft_token_ids_ptr,  # [num_tokens]
+    parents_ptr,  # [num_tokens] local parent node index, -1 for root
+    row_argmax_ptr,  # [num_tokens + batch] argmax of every logits row
+    max_spec_len,
+    max_nodes,
+):
+    """Descend the draft tree along the target model's greedy continuation.
+
+    Row layout for request r: ``row 0`` is the last committed token, ``row
+    1 + i`` is tree node ``i``.  ``row_argmax[row]`` is the token the target
+    model would emit at that row.  Starting at the root row we repeatedly look
+    for a CHILD of the current node whose draft token equals the target's
+    argmax; the accepted output is that path plus one extra (bonus) token.
+    """
+    req_idx = tl.program_id(0)
+    d0 = (
+        tl.zeros([], dtype=cu_num_draft_tokens_ptr.dtype.element_ty)
+        if req_idx == 0
+        else tl.load(cu_num_draft_tokens_ptr + req_idx - 1)
+    )
+    d1 = tl.load(cu_num_draft_tokens_ptr + req_idx)
+    n = d1 - d0
+    s1 = tl.load(cu_num_sampled_tokens_ptr + req_idx)
+    # row base of this request inside the flat logits array
+    s0 = s1 - (n + 1)
+    if n <= 0:
+        return
+
+    cur = -1  # current node index; -1 == the root row
+    pos = 0
+    active = 1
+    for _ in range(max_nodes + 1):
+        tok = tl.load(row_argmax_ptr + s0 + cur + 1)
+        tl.store(
+            output_token_ids_ptr + req_idx * (max_spec_len + 1) + pos,
+            tok,
+            mask=active == 1,
+        )
+        nxt = -1
+        for i in range(n):
+            p = tl.load(parents_ptr + d0 + i)
+            dt = tl.load(draft_token_ids_ptr + d0 + i)
+            hit = (p == cur) & (dt == tok) & (nxt < 0)
+            nxt = tl.where(hit, i, nxt)
+        found = (nxt >= 0) & (active == 1)
+        tl.store(
+            accepted_path_ptr + req_idx * max_spec_len + pos, nxt, mask=found
+        )
+        cur = tl.where(found, nxt, cur)
+        pos = tl.where(found, pos + 1, pos)
+        active = tl.where(found, active, 0)
+    tl.store(accepted_len_ptr + req_idx, pos)
+
+
+def tree_rejection_sample(
+    metadata: SpecDecodeMetadata,
+    logits: torch.Tensor,
+) -> torch.Tensor:
+    device = logits.device
+    batch_size = len(metadata.num_draft_tokens)
+    max_spec_len = metadata.max_spec_len
+    output_token_ids = torch.full(
+        (batch_size, max_spec_len + 1),
+        PLACEHOLDER_TOKEN_ID,
+        dtype=torch.int32,
+        device=device,
+    )
+    accepted_path = torch.full(
+        (batch_size, max_spec_len), -1, dtype=torch.int32, device=device
+    )
+    accepted_len = torch.zeros(batch_size, dtype=torch.int32, device=device)
+    # argmax of EVERY logits row (draft rows + bonus rows).  Same total work as
+    # the stock path (which argmaxes the target rows and samples the bonus row).
+    row_argmax = logits.argmax(dim=-1).to(torch.int32)
+    tree_greedy_descent_kernel[(batch_size,)](
+        output_token_ids,
+        accepted_path,
+        accepted_len,
+        metadata.cu_num_draft_tokens,
+        metadata.cu_num_sampled_tokens,
+        metadata.draft_token_ids,
+        metadata.tree_parents,
+        row_argmax,
+        max_spec_len,
+        max_spec_len,
+    )
+    from vllm.v1.spec_decode import tree_state
+
+    cur = tree_state.get_current()
+    if cur is not None:
+        cur.accepted_path = accepted_path
+        cur.accepted_len = accepted_len
+        # h(t) HARVEST: every tree node is a query row of THIS forward, so its
+        # hidden state is the real h(node token).  The accepted path's rows are
+        # scattered (row 1 + path[j], not row 1 + j), so publish them for the
+        # proposer -- gathering the first L rows instead silently feeds the
+        # drafter the hiddens of REJECTED nodes.
+        # The GPU tensors above are all the proposer needs: it gathers the harvested
+        # rows with a device-side index.  These two BLOCKING D2H copies existed only
+        # for the proposer's legacy host-side row list (CF_GPUCTX=0) and cost 2 host
+        # syncs per step on the critical path, so they are built only for that path.
+        import os as _os
+
+        # CF_RINGCHECK runs the legacy build alongside the ring to diff them, and the legacy
+        # build needs these; without them it silently falls back to a CONTIGUOUS row slice
+        # (i.e. rejected siblings' hiddens) and the diff reports phantom mismatches.
+        if (_os.environ.get("CF_GPUCTX", "1") != "1"
+                or _os.environ.get("CF_RINGCHECK", "0") == "1"):
+            cur.extras["accepted_path_cpu"] = accepted_path.to("cpu", non_blocking=False)
+            cur.extras["accepted_len_cpu"] = accepted_len.to("cpu", non_blocking=False)
+    return output_token_ids
