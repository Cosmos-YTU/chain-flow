+# SPDX-License-Identifier: Apache-2.0
+"""Tree speculative decoding support (chained-flow fork of vLLM 0.25.1).
+
+Stock vLLM verifies a LINEAR CHAIN of draft tokens.  This module carries the
+extra per-step state needed to verify a draft TREE in a single forward pass:
+
+  * a proposer-side registry mapping ``req_id -> (tokens, parents, depths)``
+    (the ``custom_class`` proposer hook only returns a flat token list, so the
+    tree shape travels out of band and is re-validated against the tokens the
+    scheduler actually scheduled);
+  * a per-step ``TreeStep`` object holding the flattened tree layout for the
+    current ``execute_model`` call, read by the attention backends and by the
+    rejection sampler.
+
+Everything is inert unless ``VLLM_SPEC_TREE=1``.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass, field
+
+import numpy as np
+import torch
+
+
+def tree_enabled() -> bool:
+    return os.environ.get("VLLM_SPEC_TREE", "0") == "1"
+
+
+def force_tree_attn() -> bool:
+    """Run the tree attention fix-up even for chain-shaped trees.
+
+    For a chain the ancestor mask IS the causal mask, so the fix-up is a no-op
+    mathematically; forcing it on is how we prove the decomposition is exact.
+    """
+    return os.environ.get("VLLM_SPEC_TREE_ATTN_FORCE", "0") == "1"
+
+
+def attn_off() -> bool:
+    """Debug: skip the tree attention fix-up (isolation only)."""
+    return os.environ.get("VLLM_SPEC_TREE_ATTN_OFF", "0") == "1"
+
+
+def force_tree_gdn() -> bool:
+    """Run the tree GDN kernels even for chain-shaped trees (equivalence test)."""
+    return os.environ.get("VLLM_SPEC_TREE_GDN_FORCE", "0") == "1"
+
+
+# ---------------------------------------------------------------------------
+# Proposer -> model-runner side channel
+# ---------------------------------------------------------------------------
+# req_id -> (tokens tuple, parents list[int] (-1 for root), depths list[int])
+_REGISTRY: dict[str, tuple[tuple[int, ...], list[int], list[int]]] = {}
+
+
+def register(req_id: str, tokens, parents, depths) -> None:
+    _REGISTRY[str(req_id)] = (tuple(int(t) for t in tokens), list(parents), list(depths))
+
+
+# CF_ASYNC_SPEC: under vLLM async scheduling the scheduler never sees the draft token
+# VALUES -- ``AsyncScheduler`` pads every running request with ``-1`` placeholders and the
+# worker scatters the real ids into ``input_ids`` on the GPU.  So the token-equality check
+# below would fail on every step and every tree would silently degrade to chain semantics
+# (accept ~1.0).  Length agreement is the part that still carries information there: a
+# scheduler truncation still shows up as a short list.
+PLACEHOLDER_TOKENS = False
+
+# CF_ASYNC_SPEC: proposer-installed callback that joins the in-flight draft and publishes
+# this step's tree shape into the registry.  It is invoked from `_prepare_inputs` at the
+# LAST possible moment -- immediately before the registry is read -- because it blocks on
+# the GPU, and every host instruction placed after that block is GPU idle time.
+PENDING_JOIN = None
+
+
+def join_pending() -> None:
+    if PENDING_JOIN is not None:
+        PENDING_JOIN()
+
+
+# ---------------------------------------------------------------------------
+# CF_ASYNC_SPEC: the GPU-RESIDENT tree hand-off (this is what deletes the join)
+# ---------------------------------------------------------------------------
+# The join above exists for one reason: `_prepare_inputs` needs the tree PARENTS on the
+# host to build the ancestor mask, the GDN `chain` and `target_logits_indices`.  It blocks
+# on the in-flight draft, and every host instruction after it -- the rest of the tree
+# metadata, the cudagraph dispatch, the forward launch -- then runs against a DRAINED GPU.
+# Measured at 4B: ~1.45 ms/step of pure GPU idle.
+#
+# `_GPU_TREE` is the way out.  The draft cudagraph already produced the parents ON THE
+# DEVICE (`ch[:, N:]`); everything `_prepare_inputs` derives from them is index arithmetic
+# and can be derived there too.  Publishing that tensor lets the CANONICAL steady-state
+# step skip the registry, skip the join, and let the whole of `_prepare_inputs` overlap
+# step N's GPU work.
+#
+# Consume-once by construction: a stale hand-off is worse than none (it would describe the
+# PREVIOUS step's tree), so `take_gpu_tree` clears the slot and the identity of the batch
+# is re-checked on every read.
+_GPU_TREE: dict | None = None
+
+
+def publish_gpu_tree(*, parents, req_ids, n: int, discard) -> None:
+    """Called by the proposer once the draft is enqueued.
+
+    ``parents`` is [num_rows, n] on the device, row-aligned to ``req_ids`` (which are the
+    input-batch req_ids AT DRAFT TIME).  ``discard`` drops the proposer's pending host
+    staging without synchronising, for the steps that end up taking this path.
+    """
+    global _GPU_TREE
+    _GPU_TREE = {
+        "parents": parents,
+        "req_ids": list(req_ids),
+        "n": int(n),
+        "discard": discard,
+    }
+
+
+def has_gpu_tree() -> bool:
+    """Cheap gate so the canonical predicate costs a single None check when the device
+    hand-off is not in use at all (CF_ASYNC_SPEC off).  Without it, every SYNCHRONOUS step
+    pays for a duplicate scan of `scheduled_spec_decode_tokens` plus two numpy reductions
+    -- measured at ~1% of 4B throughput, i.e. a real regression on the default path."""
+    return _GPU_TREE is not None
+
+
+def take_gpu_tree(req_ids, num_reqs: int, n: int):
+    """Return the device parents iff they describe EXACTLY this step's batch.
+
+    The input batch can condense between steps (a finished request moves a live one down
+    to a lower index), which silently re-maps every row.  Identity is therefore checked on
+    the req_id strings, not on the row count -- host data, so it costs no sync.
+    """
+    global _GPU_TREE
+    g = _GPU_TREE
+    _GPU_TREE = None
+    if g is None or g["n"] != n:
+        return None
+    r = g["req_ids"]
+    if len(r) != num_reqs:
+        return None
+    for a, b in zip(r, req_ids):
+        if a != b:
+            return None
+    p = g["parents"]
+    if p.shape[0] != num_reqs or p.shape[1] != n:
+        return None
+    return p, g["discard"]
+
+
+def drop_gpu_tree() -> None:
+    global _GPU_TREE
+    _GPU_TREE = None
+
+
+def device_walk(parents_nodes: torch.Tensor, N: int, K: int, out: torch.Tensor):
+    """Ancestor walk in ROW space, entirely on the device.
+
+    ``parents_nodes`` is [S, N] with -1 for a tree root.  Query row 0 of a request is the
+    previously committed token and row ``1 + i`` is node ``i``; a root's parent is row 0
+    and row 0's parent is itself, so the walk never escapes the request (this is exactly
+    the clamping ``tree_gdn._layout_np`` does on the host).
+
+    Writes ``out[s, t, k] = parent^k(t)`` (row-local) and returns the [S, N+1, K] view.
+    One gather per level -- K-1 kernels for the whole table, and the SAME table serves both
+    the GDN `chain` and the attention ancestor mask.
+    """
+    S = parents_nodes.shape[0]
+    dev = parents_nodes.device
+    # row-space parent table: rp[0] = 0 (self), rp[1+i] = 0 if root else 1 + parents[i]
+    rp = torch.empty((S, N + 1), dtype=torch.long, device=dev)
+    rp[:, 0] = 0
+    p = parents_nodes.long()
+    rp[:, 1:] = torch.where(p < 0, torch.zeros_like(p), p + 1)
+    cur = torch.arange(N + 1, device=dev, dtype=torch.long).expand(S, N + 1)
+    w = out[:, :, :K]
+    w[:, :, 0] = cur
+    for k in range(1, K):
+        cur = rp.gather(1, cur)
+        w[:, :, k] = cur
+    return w
+
+
+def lookup(req_id: str, tokens) -> tuple[list[int], list[int]] | None:
+    """Return (parents, depths) if a registered tree matches ``tokens`` exactly.
+
+    The scheduler may truncate/drop speculative tokens (chunked prefill, guided
+    decoding rollback).  If the tokens do not match what we registered, the tree
+    shape is stale and the caller must fall back to chain semantics.
+    """
+    ent = _REGISTRY.get(str(req_id))
+    if ent is None:
+        return None
+    toks, parents, depths = ent
+    if len(toks) != len(tokens):
+        return None
+    if not PLACEHOLDER_TOKENS:
+        for a, b in zip(toks, tokens):
+            if int(a) != int(b):
+                return None
+    return parents, depths
+
+
+def drop(req_ids) -> None:
+    live = set(str(r) for r in req_ids)
+    for k in list(_REGISTRY):
+        if k not in live:
+            _REGISTRY.pop(k, None)
+
+
+def clear_registry() -> None:
+    """Invalidate every registered tree.
+
+    Used when the caller knows the registry cannot describe the CURRENT step -- an empty
+    registry makes `lookup` return None, which takes the documented stale-tree fallback
+    (slower, PIECEWISE) instead of silently verifying a tree against the wrong shape.
+    """
+    _REGISTRY.clear()
+
+
+# ---------------------------------------------------------------------------
+# Per-step state
+# ---------------------------------------------------------------------------
+@dataclass
+class TreeStep:
+    """Flattened tree layout for the current execute_model call."""
+
+    # per draft token (flat, concatenated over requests, BFS order per request)
+    parents_np: np.ndarray  # local node parent index, -1 for the root
+    depths_np: np.ndarray  # local node depth (root == 0)
+    num_draft_tokens: np.ndarray  # [num_reqs]
+    # request indices (into the input batch) that carry a *branching* tree
+    branching: bool = False
+    # filled in by the model runner once known
+    parents_gpu: torch.Tensor | None = None
+    depths_gpu: torch.Tensor | None = None
+    # token-row index (into the flat query buffer) of each draft node
+    node_rows_np: np.ndarray | None = None
+    # [num_reqs] number of tree nodes; 0 for non-spec requests
+    # accepted path (node indices) filled by the rejection sampler
+    accepted_path: torch.Tensor | None = None
+    accepted_len: torch.Tensor | None = None
+    # attention plumbing
+    spec_req_idx: torch.Tensor | None = None
+    ctx_lens: torch.Tensor | None = None
+    cu_q: torch.Tensor | None = None
+    tree_token_idx: torch.Tensor | None = None
+    anc_mask: torch.Tensor | None = None
+    max_nodes: int = 0
+    extras: dict = field(default_factory=dict)
+
+
+def build_attn_plumbing(
+    ts: "TreeStep",
+    *,
+    num_reqs: int,
+    num_scheduled_tokens: np.ndarray,
+    cu_num_tokens: np.ndarray,
+    num_computed_tokens: np.ndarray,
+    device: torch.device,
+) -> None:
+    """Precompute everything the full-attention tree fix-up needs.
+
+    Full attention over a tree = attention over the shared PREFIX (paged KV,
+    every node sees all of it) merged (log-sum-exp) with a tiny dense attention
+    over the request's own tree nodes under an ANCESTOR mask.  This routine
+    builds the index / mask tensors for the second part and the varlen
+    descriptors for the first.
+    """
+    parents, depths = ts.parents_np, ts.depths_np
+    nd = ts.num_draft_tokens
+    off = 0
+    req_idx: list[int] = []
+    node_rows: list[np.ndarray] = []
+    ctx_lens: list[int] = []
+    anc: list[np.ndarray] = []
+    nmax = 0
+    for r in range(num_reqs):
+        n = int(nd[r])
+        if n == 0:
+            continue
+        p = parents[off : off + n]
+        off += n
+        if int(num_scheduled_tokens[r]) != n + 1:
+            # chunked prefill + spec: leave to the stock (chain) path
+            continue
+        start = int(cu_num_tokens[r]) - (n + 1)
+        req_idx.append(r)
+        node_rows.append(np.arange(start + 1, start + 1 + n, dtype=np.int64))
+        # prefix = everything up to and including the last committed token
+        ctx_lens.append(int(num_computed_tokens[r]) + 1)
+        a = np.zeros((n, n), dtype=bool)
+        for i in range(n):
+            j = i
+            while j >= 0:
+                a[i, j] = True
+                j = int(p[j])
+        anc.append(a)
+        nmax = max(nmax, n)
+    if not req_idx:
+        return
+    S = len(req_idx)
+    counts = np.array([len(x) for x in node_rows], dtype=np.int32)
+    idx_pad = np.zeros((S, nmax), dtype=np.int64)
+    valid = np.zeros((S, nmax), dtype=bool)
+    mask = np.zeros((S, nmax, nmax), dtype=bool)
+    for s in range(S):
+        n = int(counts[s])
+        idx_pad[s, :n] = node_rows[s]
+        idx_pad[s, n:] = node_rows[s][0]
+        valid[s, :n] = True
+        mask[s, :n, :n] = anc[s]
+        for i in range(n, nmax):  # padded rows attend to themselves only
+            mask[s, i, 0] = True
+    cu = np.zeros(S + 1, dtype=np.int32)
+    np.cumsum(counts, out=cu[1:])
+
+    def h2d(a, dtype):
+        return torch.from_numpy(np.ascontiguousarray(a)).to(
+            device=device, dtype=dtype, non_blocking=True
+        )
+
+    ts.spec_req_idx = h2d(np.array(req_idx, dtype=np.int64), torch.int64)
+    ts.tree_token_idx = h2d(np.concatenate(node_rows), torch.int64)
+    ts.ctx_lens = h2d(np.array(ctx_lens, dtype=np.int32), torch.int32)
+    ts.cu_q = h2d(cu, torch.int32)
+    ts.anc_mask = h2d(mask, torch.bool)
+    ts.extras["idx_pad"] = h2d(idx_pad, torch.int64)
+    ts.extras["valid_pad"] = h2d(valid, torch.bool)
+    # PADDED-ROW COMPACTION INDEX.  `_tree_attention_fixup` used to compact its
+    # [S*nmax, ...] results with BOOLEAN MASK indexing (`x[valid_pad.view(-1)]`),
+    # whose output shape is data-dependent and therefore forces a D2H
+    # synchronization -- TWICE PER ATTENTION LAYER, i.e. 2 x n_attn_layers host
+    # syncs inside every verify forward.  The valid positions are already known
+    # HERE, on the host, so publish them as an int index and let the fixup use
+    # `index_select` (static shape, no sync).
+    ts.extras["valid_idx"] = h2d(np.flatnonzero(valid.reshape(-1)), torch.int64)
+    # The attention fix-up masks with `~anc_mask`; negating it per attention layer is
+    # n_attn_layers wasted launches on a host-bound path.  Ship the negation.
+    ts.extras["not_anc"] = h2d(~mask, torch.bool)
+    ts.extras["counts"] = counts
+    ts.extras["nmax"] = nmax
+    ts.extras["max_ctx"] = int(max(ctx_lens))
+    ts.extras["num_spec"] = S
+    ts.extras["spec_req_np"] = np.array(req_idx, dtype=np.int64)
+
+
+# ---------------------------------------------------------------------------
+# PERSISTENT (cudagraph-safe) step state -- CF_TREE_FULLCG
+# ---------------------------------------------------------------------------
+# Everything above allocates fresh tensors every step.  That is fine for the
+# PIECEWISE path (the python re-runs and re-reads them) but fatal under a FULL
+# cudagraph, which bakes the ADDRESS of every tensor its kernels touch: a graph
+# captured against step 1's plumbing would keep reading step 1's (freed, reused)
+# memory on every replay -- silently wrong, no crash, and it shows up first as an
+# accept drop.
+#
+# So for the one batch shape the graph is captured for -- S requests, each with
+# exactly N tree nodes and N+1 scheduled query rows -- the whole plumbing is a
+# module-level singleton, allocated once and REFILLED IN PLACE.
+#
+# STATIC-SHAPE INVENTORY (constant given (S, N), never refilled):
+#   spec_req_idx = arange(S)          (graphable => every request is a spec req)
+#   tree_token_idx / idx_pad          (row r*(N+1)+1 .. r*(N+1)+N)
+#   valid_idx = arange(S*N), valid_pad = all True, cu_q = arange(S+1)*N
+#   nmax = N, num_spec = S, counts = N
+#   max_ctx  -- a COMPILE-TIME CONSTANT baked into the FlashAttention launch, so
+#               it must be an UPPER BOUND (max_model_len).  The true per-request
+#               lengths still come from the `ctx_lens` tensor.
+# PER-STEP (refilled through pinned staging):  not_anc [S,N,N], ctx_lens [S].
+_STATIC_STEPS: dict[tuple, TreeStep] = {}
+
+
+def fullcg_check() -> bool:
+    """CF_TREE_FULLCG_CHECK=1: re-derive the plumbing the dynamic way on every
+    live step and assert the static buffers match, so staleness is LOUD."""
+    return os.environ.get("CF_TREE_FULLCG_CHECK", "0") == "1"
+
+
+def get_static_step(
+    *, S: int, N: int, device: torch.device, max_ctx: int
+) -> TreeStep:
+    key = (int(S), int(N), str(device))
+    ts = _STATIC_STEPS.get(key)
+    if ts is not None:
+        return ts
+    # Allocate OUTSIDE inference mode.  A tensor born inside `inference_mode`
+    # is an "inference tensor" and may never be mutated outside it -- but these
+    # buffers are refilled from both `_prepare_inputs` (inference mode) and
+    # `_warmup_and_capture` (not).
+    with torch.inference_mode(False):
+        return _alloc_static_step(key, S, N, device, max_ctx)
+
+
+def _alloc_static_step(key, S: int, N: int, device, max_ctx: int) -> TreeStep:
+    rows = (
+        np.arange(S, dtype=np.int64)[:, None] * (N + 1)
+        + 1
+        + np.arange(N, dtype=np.int64)[None, :]
+    )  # [S, N]
+
+    def h2d(a, dtype):
+        return torch.from_numpy(np.ascontiguousarray(a)).to(device=device, dtype=dtype)
+
+    ts = TreeStep(
+        parents_np=np.zeros(S * N, dtype=np.int32),
+        depths_np=np.zeros(S * N, dtype=np.int32),
+        num_draft_tokens=np.full(S, N, dtype=np.int32),
+        branching=True,
+        max_nodes=N,
+    )
+    ts.spec_req_idx = h2d(np.arange(S), torch.int64)
+    ts.tree_token_idx = h2d(rows.reshape(-1), torch.int64)
+    ts.cu_q = h2d(np.arange(S + 1) * N, torch.int32)
+    ts.ctx_lens = torch.zeros(S, dtype=torch.int32, device=device)
+    # `anc_mask` is DEAD after the hoist -- only extras["not_anc"] is read -- so
+    # the static step deliberately leaves it None.
+    ts.anc_mask = None
+    ts.extras["idx_pad"] = h2d(rows, torch.int64)
+    ts.extras["valid_pad"] = torch.ones((S, N), dtype=torch.bool, device=device)
+    ts.extras["valid_idx"] = h2d(np.arange(S * N), torch.int64)
+    ts.extras["not_anc"] = torch.zeros((S, N, N), dtype=torch.bool, device=device)
+    ts.extras["counts"] = np.full(S, N, dtype=np.int32)
+    ts.extras["nmax"] = N
+    ts.extras["num_spec"] = S
+    ts.extras["max_ctx"] = int(max_ctx)
+    ts.extras["spec_req_np"] = np.arange(S, dtype=np.int64)
+    ts.extras["static"] = True
+    ts.extras["_pin_not_anc"] = torch.empty(
+        (S, N, N), dtype=torch.bool, pin_memory=True
+    )
+    ts.extras["_pin_ctx"] = torch.empty(S, dtype=torch.int32, pin_memory=True)
+    # CF_ASYNC_SPEC device-resident scratch for `fill_static_step_gpu`.  Allocated HERE,
+    # inside the caller's `inference_mode(False)`, for the same reason the rest of the
+    # persistent step is: a tensor born inside inference mode may never be mutated outside
+    # it, and these are refilled from both `_prepare_inputs` (inference) and the capture
+    # path (not).  Sized for the worst-case chain length so one buffer covers any maxd.
+    ts.extras["_walk"] = torch.empty((S, N + 1, N + 1), dtype=torch.long, device=device)
+    ts.extras["_anc_buf"] = torch.empty((S, N, N + 1), dtype=torch.bool, device=device)
+    _STATIC_STEPS[key] = ts
+    return ts
+
+
+def fill_static_step(
+    ts: TreeStep,
+    *,
+    parents_np: np.ndarray,
+    depths_np: np.ndarray,
+    ctx_lens_np: np.ndarray,
+    maxd: int,
+    device: torch.device,
+    parents_gpu: torch.Tensor | None = None,
+    depths_gpu: torch.Tensor | None = None,
+    ctx_lens_gpu: torch.Tensor | None = None,
+) -> None:
+    """Refill the persistent step IN PLACE (host->device, no sync, no alloc).
+
+    ``ctx_lens_gpu`` overrides ``ctx_lens_np``.  Under ASYNC SCHEDULING the host's
+    ``num_computed_tokens_cpu`` is the scheduler's OPTIMISTIC value (all drafts assumed
+    accepted); only the GPU copy has been walked back by the previous step's rejections.
+    The tree attention fix-up uses ``ctx_lens`` as the paged-KV prefix length, so taking it
+    from the host there would make every node attend past the real end of its context.
+    """
+    from vllm.v1.spec_decode import tree_gdn as _tg
+
+    S = ts.extras["num_spec"]
+    N = ts.extras["nmax"]
+    # --- ancestor mask -----------------------------------------------------
+    anc = np.zeros((S, N, N), dtype=bool)
+    for s in range(S):
+        p = parents_np[s * N : (s + 1) * N]
+        for i in range(N):
+            j = i
+            while j >= 0:
+                anc[s, i, j] = True
+                j = int(p[j])
+    pin = ts.extras["_pin_not_anc"]
+    pin.copy_(torch.from_numpy(~anc))
+    ts.extras["not_anc"].copy_(pin, non_blocking=True)
+    if ctx_lens_gpu is not None:
+        ts.ctx_lens.copy_(ctx_lens_gpu[: ts.ctx_lens.shape[0]], non_blocking=True)
+    else:
+        pc = ts.extras["_pin_ctx"]
+        pc.copy_(torch.from_numpy(np.ascontiguousarray(ctx_lens_np, dtype=np.int32)))
+        ts.ctx_lens.copy_(pc, non_blocking=True)
+    # --- host-side fields read outside the graph ---------------------------
+    ts.parents_np = parents_np
+    ts.depths_np = depths_np
+    ts.parents_gpu = parents_gpu
+    ts.depths_gpu = depths_gpu
+    ts.branching = True
+    ts.accepted_path = None
+    ts.accepted_len = None
+    ts.extras.pop("gdn_next_accepted", None)
+    ts.extras.pop("accepted_path_cpu", None)
+    ts.extras.pop("accepted_len_cpu", None)
+    # --- GDN layout: build/fill the singleton and stash it where the GDN
+    # layer's `extras.get("gdn_layout")` will find it (no call-site edit).
+    lay = _tg.get_static_layout(S=S, N=N, maxd=maxd, device=device)
+    _tg.fill_static_layout(
+        lay,
+        parents_np=parents_np,
+        depths_np=depths_np,
+        num_draft_tokens=ts.num_draft_tokens,
+        spec_req_order=ts.extras["spec_req_np"],
+    )
+    ts.extras["gdn_layout"] = lay
+
+
+def fill_static_step_gpu(
+    ts: TreeStep,
+    *,
+    parents_gpu_2d: torch.Tensor,
+    depths_np: np.ndarray,
+    ctx_lens_gpu: torch.Tensor,
+    maxd: int,
+    device: torch.device,
+) -> None:
+    """`fill_static_step` with NO host dependency on the tree shape.
+
+    Everything the step needs from the parents -- the ancestor mask and the GDN `chain` --
+    is derived on the device from ONE walk table, so the draft never has to come back to
+    the host and `_prepare_inputs` never has to block on it.  ``depths_np`` is still a host
+    array, but it is a CONSTANT of the tree shape (level-major BFS: ``depth[i] = i // keep``),
+    not step data.
+
+    Kernel count is ~16 launches for the whole thing.  That is not a saving over the numpy
+    version -- it is roughly a wash -- and it is not the point: the point is that these
+    launches can be issued while step N is still running on the GPU, which the host walk
+    could not.
+    """
+    from vllm.v1.spec_decode import tree_gdn as _tg
+
+    S = ts.extras["num_spec"]
+    N = ts.extras["nmax"]
+    assert parents_gpu_2d.shape == (S, N), (
+        f"tree GPU parents {tuple(parents_gpu_2d.shape)} != ({S}, {N})"
+    )
+    chain_w = max(maxd, 3) + 1
+    # One walk table serves both consumers: row-space, [S, N+1, chain_w].
+    w = device_walk(parents_gpu_2d, N, chain_w, ts.extras["_walk"])
+
+    # --- ancestor mask, from the walk --------------------------------------
+    # Rows 1..N are the nodes.  A walk entry of 0 means "past the root", so it is routed to
+    # a trash column instead of being clamped onto node 0 (which would mark a bogus
+    # ancestor).  `maxd` columns is exactly the longest possible chain.
+    v = w[:, 1:, :maxd]                                   # [S, N, maxd] row ids
+    idx = torch.where(v > 0, v - 1, torch.full_like(v, N))
+    buf = ts.extras["_anc_buf"]
+    buf.zero_()
+    buf.scatter_(2, idx, True)
+    torch.logical_not(buf[:, :, :N], out=ts.extras["not_anc"])
+
+    ts.ctx_lens.copy_(ctx_lens_gpu[: ts.ctx_lens.shape[0]], non_blocking=True)
+
+    # --- host-side fields --------------------------------------------------
+    # `parents_np` is deliberately None: there IS no host copy on this path, and anything
+    # that silently fell back to reading it would be reading a stale step.
+    ts.parents_np = None
+    ts.depths_np = depths_np
+    ts.parents_gpu = parents_gpu_2d.reshape(-1)
+    ts.depths_gpu = None
+    ts.branching = True
+    ts.accepted_path = None
+    ts.accepted_len = None
+    ts.extras.pop("gdn_next_accepted", None)
+    ts.extras.pop("accepted_path_cpu", None)
+    ts.extras.pop("accepted_len_cpu", None)
+
+    # --- GDN layout --------------------------------------------------------
+    # `chain` is the SAME walk, made global: row t of request s is s*(N+1) + t.
+    lay = _tg.get_static_layout(S=S, N=N, maxd=maxd, device=device)
+    base = (
+        torch.arange(S, device=device, dtype=torch.long).unsqueeze(1) * (N + 1)
+    ).unsqueeze(2)
+    lay.chain.copy_((w + base).reshape(S * (N + 1), chain_w))
+    _tg.fill_static_layout_gpu(lay, depths_np=depths_np)
+    ts.extras["gdn_layout"] = lay
+
+
+def check_static_step(
+    ts: TreeStep,
+    *,
+    num_reqs: int,
+    num_scheduled_tokens: np.ndarray,
+    cu_num_tokens: np.ndarray,
+    num_computed_tokens: np.ndarray,
+    device: torch.device,
+) -> None:
+    """CF_TREE_FULLCG_CHECK=1 -- assert the persistent buffers equal what the
+    dynamic (PIECEWISE) path would have produced for THIS step."""
+    from vllm.v1.spec_decode import tree_gdn as _tg
+
+    assert ts.parents_np is not None, (
+        "[tree-fullcg-check] this step was filled by `fill_static_step_gpu`, which keeps "
+        "no host copy of the parents. Run the check with CF_ASYNC_SPEC=0."
+    )
+
+    ref = TreeStep(
+        parents_np=ts.parents_np,
+        depths_np=ts.depths_np,
+        num_draft_tokens=ts.num_draft_tokens,
+        branching=True,
+        max_nodes=int(ts.num_draft_tokens.max()),
+    )
+    build_attn_plumbing(
+        ref,
+        num_reqs=num_reqs,
+        num_scheduled_tokens=num_scheduled_tokens,
+        cu_num_tokens=cu_num_tokens,
+        num_computed_tokens=num_computed_tokens,
+        device=device,
+    )
+    for name, a, b in (
+        ("spec_req_idx", ts.spec_req_idx, ref.spec_req_idx),
+        ("tree_token_idx", ts.tree_token_idx, ref.tree_token_idx),
+        ("ctx_lens", ts.ctx_lens, ref.ctx_lens),
+        ("cu_q", ts.cu_q, ref.cu_q),
+        ("idx_pad", ts.extras["idx_pad"], ref.extras["idx_pad"]),
+        ("valid_idx", ts.extras["valid_idx"], ref.extras["valid_idx"]),
+        ("valid_pad", ts.extras["valid_pad"], ref.extras["valid_pad"]),
+        ("not_anc", ts.extras["not_anc"], ref.extras["not_anc"]),
+    ):
+        assert torch.equal(a, b), f"[tree-fullcg-check] {name} mismatch"
+    assert ts.extras["nmax"] == ref.extras["nmax"], "[tree-fullcg-check] nmax"
+    assert ts.extras["num_spec"] == ref.extras["num_spec"], "[tree-fullcg-check] S"
+    assert ts.extras["max_ctx"] >= ref.extras["max_ctx"], (
+        f"[tree-fullcg-check] max_ctx {ts.extras['max_ctx']} is not an upper "
+        f"bound for {ref.extras['max_ctx']}"
+    )
+    rlay = _tg.build_gdn_layout(
+        parents_np=ts.parents_np,
+        depths_np=ts.depths_np,
+        num_draft_tokens=ts.num_draft_tokens,
+        spec_req_order=ts.extras["spec_req_np"],
+        device=device,
+    )
+    slay = ts.extras["gdn_layout"]
+    for name in ("chain", "depth", "seq", "loc"):
+        assert torch.equal(getattr(slay, name), getattr(rlay, name)), (
+            f"[tree-fullcg-check] gdn_layout.{name} mismatch"
+        )
+    assert slay.maxd == rlay.maxd and slay.num_rows == rlay.num_rows, (
+        "[tree-fullcg-check] gdn_layout maxd/num_rows mismatch"
+    )
+    assert slay.hoist is None, "[tree-fullcg-check] stale hoist cache"
+
+
+def synthetic_fill(ts: TreeStep, *, keep: int, depth: int, device: torch.device) -> None:
+    """Fill the persistent step with a shape-valid dummy tree, for CAPTURE.
+
+    Values are irrelevant to a capture (only shapes, addresses and the
+    host-constant kernel arguments are baked); what matters is that the tree is
+    BRANCHING, has the right node count, and has the same ``maxd`` as every
+    graphable step -- ``maxd`` is a runtime kernel argument of the GDN scan and
+    the chain width is a tensor shape, so both must match at replay.
+    """
+    S = ts.extras["num_spec"]
+    N = ts.extras["nmax"]
+    assert keep * depth == N, f"tree shape {keep}x{depth} != {N} nodes"
+    depths = np.array([d for d in range(depth) for _ in range(keep)], dtype=np.int32)
+    parents = np.empty(N, dtype=np.int32)
+    for i in range(N):
+        lvl, slot = i // keep, i % keep
+        parents[i] = -1 if lvl == 0 else (lvl - 1) * keep + slot
+    fill_static_step(
+        ts,
+        parents_np=np.tile(parents, S),
+        depths_np=np.tile(depths, S),
+        ctx_lens_np=np.ones(S, dtype=np.int32),
+        maxd=depth,
+        device=device,
+    )
+
+
+CURRENT: TreeStep | None = None
+
+
+def set_current(step: TreeStep | None) -> None:
+    global CURRENT
+    CURRENT = step
+
+
+def get_current() -> TreeStep | None:
+    return CURRENT
--- a/vllm/v1/spec_decode/tree_gdn_verify.py
+++ b/vllm/v1/spec_decode/tree_gdn_verify.py
@@ -0,0 +1,144 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CF_GDN_CUDA=1: raw-CUDA, bit-exact drop-in for the Triton `_tree_gdn_kernel`.
+
+See ``tree_gdn_verify.cu`` for the arithmetic-order archaeology.  Both launches on
+the CF_GDN_DEFER path route through here -- the verify pass (all rows, output
+only) and the deferred finalize (accepted-leaf rows, state only) -- because they
+are the same kernel with different constexpr flags.
+
+Bit-exact against Triton at the 41-node shipping shape: 0 differing elements in
+``o`` and 0 in the written state, for every (BV, warps) combination.  Guard that
+with ``CF_GDN_CUDA_CHECK=1``, which runs the Triton kernel alongside and tallies
+mismatching elements in a device counter (no host sync, so it survives cudagraph
+replay).
+
+Tunables: ``CF_GDN_CUDA_BV`` (v-rows per warp, default 16 -- 32 costs 255
+registers and 8 costs redundant k-side work), ``CF_GDN_CUDA_WARPS`` (warps per
+block, default 1).
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import torch
+
+_ENABLED: bool | None = None
+_MOD = None
+_SRC = Path(__file__).resolve().parent / "tree_gdn_verify.cu"
+_BV = int(os.environ.get("CF_GDN_CUDA_BV", "0") or 0) or 16
+_WARPS = int(os.environ.get("CF_GDN_CUDA_WARPS", "0") or 0) or 1
+_CHECK = os.environ.get("CF_GDN_CUDA_CHECK", "0") == "1"
+# Which of the two launches the CUDA kernel serves.  They have OPPOSITE winners
+# and the reason is grid shape, not code quality: the verify pass launches
+# NV*HV*T warps (10k+) and Triton edges it there, while the finalize launches
+# NV*HV*S -- 128 warps at batch 1, far too few to hide anything -- where the CUDA
+# kernel's lower per-warp latency wins by ~2.3 us/layer at every size measured.
+_DO_VERIFY = os.environ.get("CF_GDN_CUDA_VERIFY", "1") == "1"
+_DO_FINAL = os.environ.get("CF_GDN_CUDA_FINALIZE", "1") == "1"
+_DBG = os.environ.get("CF_GDN_CUDA_DEBUG", "0") == "1"
+_CHK = None
+
+
+def _load():
+    global _MOD
+    if _MOD is None:
+        from torch.utils.cpp_extension import load
+
+        os.environ.setdefault("CUDA_HOME", "/usr/local/cuda")
+        os.environ.setdefault("TORCH_CUDA_ARCH_LIST", "12.0")
+        # NO -use_fast_math: it would swap the accurate logf the softplus needs.
+        _MOD = load(
+            name="cf_tree_gdn_verify",
+            sources=[str(_SRC)],
+            extra_cuda_cflags=["-O3", "-lineinfo", "--expt-relaxed-constexpr"],
+            verbose=False,
+        )
+    return _MOD
+
+
+def enabled() -> bool:
+    global _ENABLED
+    if _ENABLED is None:
+        _ENABLED = os.environ.get("CF_GDN_CUDA", "0") == "1"
+        if _ENABLED:
+            _load()
+    return _ENABLED
+
+
+def route(is_verify: bool) -> bool:
+    """True if the CUDA kernel should serve this launch."""
+    return _DO_VERIFY if is_verify else _DO_FINAL
+
+
+def check_mode() -> bool:
+    """CF_GDN_CUDA_CHECK=1 -- tally the ENABLED geometry (CF_GDN_BV and/or the
+    CUDA kernel) against the reference Triton BV=32 arithmetic.  Not CUDA-specific
+    despite the name; the name is kept because the bench harness already prints
+    this counter and that harness is shared with other agents."""
+    return _CHECK
+
+
+def tally(got, ref) -> None:
+    global _CHK
+    if _CHK is None:
+        _CHK = torch.zeros(4, dtype=torch.int64, device=got.device)
+    bad = got != ref
+    _CHK[0] += bad.sum()
+    _CHK[1] += got.numel()
+    _CHK[2] += bad.any().to(torch.int64)
+    _CHK[3] += 1
+
+
+def check_counters():
+    """[mismatching elements, elements, calls with any mismatch, calls]"""
+    return None if _CHK is None else _CHK.tolist()
+
+
+_WHY = 0
+
+
+def supported(e: dict, meta) -> bool:
+    global _WHY
+    def no(r):
+        global _WHY
+        if _WHY < 4 and os.environ.get("CF_GDN_CUDA_DEBUG") == "1":
+            _WHY += 1
+            print(f"[cf-gdn-cuda] fallback: {r}", flush=True)
+        return False
+    if e["K"] != 128 or e["V"] % _BV or e["V"] > 128:
+        return no(f'shape K={e["K"]} V={e["V"]}')
+    if e["q"].dtype not in (torch.float16, torch.bfloat16):
+        return no(f'q dtype {e["q"].dtype}')
+    if e["state"].dtype not in (torch.float32, torch.bfloat16):
+        return no(f'state dtype {e["state"].dtype}')
+    for nm, t in (("q", e["q"]), ("k", e["k"]), ("v", e["v"])):
+        if not t.is_contiguous():
+            return no(f"{nm} not contiguous")
+    if meta.chain.dtype != torch.int32 or meta.depth.dtype != torch.int32:
+        return no("chain/depth dtype")
+    if meta.out_slot.dtype != torch.int32 or meta.init_slot.dtype != torch.int32:
+        return no("slot dtype")
+    if e["state"].stride(-1) != 1:
+        return no("state stride")
+    return True
+
+
+def run(e: dict, *, rows, n_rows: int, write_out: bool, write_state: bool) -> None:
+    meta = e["meta"]
+    global _DBG
+    if _DBG:
+        _DBG = False
+        print(
+            f"[cf-gdn-cuda] live: BV={_BV} warps={_WARPS} rows={n_rows} "
+            f"maxd={meta.maxd} HV={e['HV']} V={e['V']} state={e['state'].dtype}",
+            flush=True,
+        )
+    _load().gdn_verify(
+        e["A_log"], e["dt_bias"], e["a"], e["b"], e["q"], e["k"], e["v"], e["o"],
+        e["state"], meta.chain, meta.depth, meta.out_slot, meta.init_slot, rows,
+        float(e["scale"]), int(n_rows), int(meta.maxd), int(e["H"]),
+        int(e["HV"]), int(e["V"]), int(_BV), int(_WARPS), bool(write_out),
+        bool(write_state),
+    )
--- a/vllm/v1/spec_decode/tree_gdn_factor.py
+++ b/vllm/v1/spec_decode/tree_gdn_factor.py
@@ -0,0 +1,160 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CF_GDN_FACTOR=1: shared-root factorisation of the tree GDN recurrence.
+
+See ``tree_gdn_factor.cu`` for the algebra.  The short version: every node's
+recurrent state is the request's INITIAL state decayed plus at most ``depth``
+rank-1 terms, and the initial state is shared by all 41 nodes -- so the whole
+layer needs to read it ONCE (2.00 MiB) instead of once per node (82 MiB), and
+needs to write no state at all.
+
+REQUIRES CF_GDN_DEFER=1.  This kernel deliberately produces only ``o``; the one
+recurrent state that survives verification (the accepted leaf's) is materialised
+after sampling by the ORIGINAL Triton kernel, so the state carried into the next
+step stays bit-exact whatever this kernel does to the logits.
+
+NOT BIT-EXACT, BY CONSTRUCTION.  Unlike the fused tree-attention kernel -- which
+is a resummation of the same expression and could therefore be made exact -- this
+is a different expression for the same real number.  Expect ~1 ulp drift and
+expect it to move tokens; ``CF_GDN_FACTOR_CHECK=1`` tallies mismatching output
+elements against the Triton kernel on the device (no host sync, so it works under
+cudagraph replay) and the 7-domain sweep reports what it does to the text.
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import torch
+
+_ENABLED: bool | None = None
+_MOD = None
+_SRC = Path(__file__).resolve().parent / "tree_gdn_factor.cu"
+_DBG = os.environ.get("CF_GDN_FACTOR_DEBUG", "0") == "1"
+_CHECK = os.environ.get("CF_GDN_FACTOR_CHECK", "0") == "1"
+_BV = int(os.environ.get("CF_GDN_FACTOR_BV", "0") or 0) or 32
+_CHK = None
+
+
+def _load():
+    global _MOD
+    if _MOD is None:
+        from torch.utils.cpp_extension import load
+
+        os.environ.setdefault("CUDA_HOME", "/usr/local/cuda")
+        os.environ.setdefault("TORCH_CUDA_ARCH_LIST", "12.0")
+        _MOD = load(
+            name="cf_tree_gdn_factor",
+            sources=[str(_SRC)],
+            extra_cuda_cflags=["-O3", "-lineinfo", "--expt-relaxed-constexpr"],
+            verbose=False,
+        )
+    return _MOD
+
+
+def enabled() -> bool:
+    """Built at model-load time, never inside a cudagraph capture."""
+    global _ENABLED
+    if _ENABLED is None:
+        _ENABLED = os.environ.get("CF_GDN_FACTOR", "0") == "1"
+        if _ENABLED:
+            _load()
+    return _ENABLED
+
+
+def check_mode() -> bool:
+    return _CHECK
+
+
+def tally(got: torch.Tensor, ref: torch.Tensor) -> None:
+    global _CHK
+    if _CHK is None:
+        _CHK = torch.zeros(4, dtype=torch.int64, device=got.device)
+    both_nan = torch.isnan(got.float()) & torch.isnan(ref.float())
+    bad = (got != ref) & ~both_nan
+    _CHK[0] += bad.sum()
+    _CHK[1] += got.numel()
+    _CHK[2] += bad.any().to(torch.int64)
+    _CHK[3] += 1
+
+
+def check_counters():
+    """[mismatching elements, elements, calls with any mismatch, calls]"""
+    return None if _CHK is None else _CHK.tolist()
+
+
+def supported(*, layout, meta, q, k, v, o, state, Kd, Vd) -> bool:
+    if layout is None:
+        return False
+    rs = getattr(layout, "row_start", None)
+    rc = getattr(layout, "row_count", None)
+    if rs is None or rc is None:
+        return False
+    if Kd != 128 or Vd % _BV or Vd > 128:
+        return False
+    if q.dtype not in (torch.float16, torch.bfloat16) or state.dtype != torch.float32:
+        return False
+    if layout.maxd > 8 or int(layout.n_max) > 64:
+        return False
+    for t in (q, k, v, o):
+        if not t.is_contiguous():
+            return False
+    if not (meta.chain.dtype == torch.int32 and meta.depth.dtype == torch.int32):
+        return False
+    if meta.init_slot.dtype != torch.int32:
+        return False
+    sm = _load().gdn_factor_smem(int(layout.n_max), _BV, int(layout.maxd))
+    return sm <= 160 * 1024
+
+
+def run(
+    *,
+    A_log,
+    dt_bias,
+    a,
+    b,
+    q,
+    k,
+    v,
+    o,
+    state,
+    meta,
+    layout,
+    scale,
+    H,
+    HV,
+    Vd,
+) -> None:
+    global _DBG
+    if _DBG:
+        _DBG = False
+        print(
+            f"[cf-gdn-factor] live: S={layout.row_start.numel()} "
+            f"n_max={int(layout.n_max)} maxd={layout.maxd} H={H} HV={HV} "
+            f"V={Vd} BV={_BV} dtype={q.dtype} "
+            f"smem={_load().gdn_factor_smem(int(layout.n_max), _BV, int(layout.maxd))}B",
+            flush=True,
+        )
+    _load().gdn_factor(
+        A_log,
+        dt_bias,
+        a,
+        b,
+        q,
+        k,
+        v,
+        o,
+        state,
+        meta.chain,
+        meta.depth,
+        meta.init_slot,
+        layout.row_start32,
+        layout.row_count,
+        float(scale),
+        int(layout.maxd),
+        int(layout.n_max),
+        int(H),
+        int(HV),
+        int(Vd),
+        int(_BV),
+    )
--- a/vllm/v1/spec_decode/tree_attn_fused.py
+++ b/vllm/v1/spec_decode/tree_attn_fused.py
@@ -0,0 +1,326 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CF_TREE_FUSED_ATTN=1: one hand-written CUDA kernel for the tree-attention
+fix-up's suffix half + the log-sum-exp merge.  See ``tree_attn_fused.cu``.
+
+WHY.  ``_tree_attention_fixup`` (flash_attn.py) computes the exact tree result
+as ``prefix (paged FA) (+lse) suffix (dense N x N, ancestor-masked)``.  The
+prefix half is a single FlashAttention launch, but the suffix half was a chain
+of ~16 eager torch ops -- three ``index_select``s, two ``repeat_interleave``s,
+an fp32 ``einsum``, ``masked_fill_``, ``amax``, ``exp``, ``sum``, ``log``,
+``div``, a second fp32 ``einsum``, two compaction ``index_select``s,
+``merge_attn_states`` and ``index_copy_`` -- ONCE PER FULL-ATTENTION LAYER.
+
+At the shipping tree the tensors involved are minuscule ([1, H, 40, 40] scores
+-- note the tree is CF_K - 1 = 40 NODES, not 41; 41 is CF_K, which counts the
+spare mamba state column), so every one of those launches is pure overhead:
+measured on 4B / batch 1 the whole fix-up costs 604 us per forward (11251.5 us
+with it, 10647.9 us with VLLM_SPEC_TREE_ATTN_OFF=1) of which only 87 us is the
+FlashAttention prefix call.  The rest is ~112 tiny kernel launches per step.
+
+This kernel does the whole suffix + merge in ONE launch per layer (8 per 4B/9B
+forward, 16 per 27B -- the layers are separated by GDN layers and MLPs so they
+cannot be merged further) and writes straight into ``output`` at the tree rows.
+Measured on the shipping shape (S=1, N=40, D=256, fp16, warps=4, gk=8):
+
+              eager chain   this kernel   per forward saved
+  4B / 9B     59.0 us/layer   5.33 us/layer   8 x 53.7 = 430 us
+  27B         61.9 us/layer   5.74 us/layer  16 x 56.2 = 899 us
+
+End to end, 7-domain batch-1 sweep, CF_MAXTOK=256: 4B 125.0 -> 130.4 tok/s,
+9B 81.7 -> 82.6, 27B 38.4 -> 39.3.
+
+SCOPE.  Only the FULL-cudagraph *static* tree step is handled (S requests x
+exactly N nodes, no padded rows) -- that is the shipping shape and it is what
+703/711 steps dispatch to.  Anything else falls back to the eager path, and so
+does any head_size the kernel is not instantiated for; ``fused_suffix_merge``
+returns False in that case and the caller runs the eager chain.
+
+NUMERICS.  The kernel is BIT-EXACT against ``_tree_suffix_eager`` at ALL THREE
+model sizes -- in-situ ``CF_TFA_CHECK=1`` over a full 7-domain sweep gives
+mismatching_elements = 0 at 4B (1.05e9 elements, 5728 calls), 9B (9.96e8, 5384)
+and 27B (2.80e9, 10016), covering H = 16 and H = 24 and every cudagraph-warmup
+batch S = 1..12.  Token ids are byte-identical to a flags-OFF run on 7/7 domains
+at 4B and 9B and on 6/7 at 27B -- and the 27B domain that differs (poff=2) ALSO
+differs between two flags-OFF runs of identical configuration, i.e. it is
+run-to-run nondeterminism in the surrounding pipeline, not this kernel.  (Same
+family as the known poff=3 artifact, where accept moves 2.448 <-> 2.471 at an
+identical token count.)  Exactness did not come for free; each of these was
+measured to matter, and each one, when wrong, put ~1 ulp on ~0.01% of elements
+and flipped real tokens:
+
+  * q.k^T is fp32-IEEE, never a tensor-core fp16/tf32 dot (the cheap dot is
+    ~8 us/layer faster but doubles the drift and changes the text), AND it is a
+    STRICTLY SEQUENTIAL FFMA chain over the head dim, because that is what
+    cuBLAS SGEMM does for this shape.  A warp-parallel dot with a cross-lane
+    tree is ~3x cheaper and disagrees on ~1 element in 10^4.
+  * the denominator reproduces ATen's ``sum(dim=-1)`` reduction (block width 32,
+    shfl-down tree), not a left-to-right sum.
+  * the merge reproduces the CUSTOM CUDA OP that
+    ``vllm/v1/attention/ops/merge_attn_states.py`` dispatches to on CUDA -- NOT
+    ``triton_merge_attn_states.py``, whose arithmetic differs.
+
+Bit-exactness is a property of the SHAPE, not a theorem: cuBLAS picks its SGEMM
+tiling per problem size, so a change of tree size can move the q.k^T
+accumulation order out from under the sequential chain.  Swept offline, N =
+8..128 x {fp16, bf16} x H in {16, 24}, head sizes 64/128/256: EVERY N <= 127 is
+exact and N == 128 alone is not (cuBLAS switches tiling at exactly m=n=128).
+``fused_suffix_merge`` therefore refuses N >= 128 outright rather than running
+an inexact fast path.  Re-run ``CF_TFA_CHECK=1`` whenever the tree shape, the
+model or the torch/cuBLAS version changes -- a reduction-order change shows up
+as a nonzero counter long before it shows up as a wrong token.
+
+SPEED OF LIGHT.  This kernel is LATENCY-bound and cannot be anything else: the
+grid is H*N warps (640 at 4B/9B, 960 at 27B) against 188 SMs x 4 schedulers, so
+ncu measures 0.21-0.32 waves/SM -- the launch does not fill the machine ONCE,
+about one warp per scheduler, nothing resident to cover a miss.  Consequently
+issue-slot utilisation is 13-17%, warps-active 8-10% of peak, and the dominant
+stall is long_scoreboard at ~4 cycles per issued instruction.  Against the
+compulsory working set (1.15 MB at 4B/9B, 1.64 MB at 27B, L2-resident) the
+L2 roofline is 38/55 ns and DRAM is 0.72/1.03 us, versus 5.33/5.74 us achieved:
+~1% of the L2 roofline and ~14-18% of DRAM.  Those rooflines are not reachable
+here -- the floor is the ~1.0 us graph-launch cost plus one L2 round trip for
+the prologue (together 1.64/1.84 us, measured by ablation) plus the 256-deep
+SEQUENTIAL FFMA chain (421 ns) that bit-exactness forbids parallelising.  Stage
+costs at 27B: prologue+store 1.84 us, q.k^T dot 3.68 us, denominator ~0, P.V
+0.17 us, merge 0.05 us.  ptxas: 40-128 registers, 0 spill bytes and 0 stack
+frame across all 48 instantiations.
+
+TUNABLES (env, all optional): ``CF_TFA_WARPS`` warps per block (default 4 --
+measured best at BOTH H=16 and H=24), ``CF_TFA_GK`` ancestor columns held in
+registers for P.V (default 8; GK also sets the q.k^T prefetch depth CH),
+``CF_TFA_DEBUG=1`` one-shot shape print, ``CF_TFA_FORCE_FALLBACK=1`` A/A control,
+``CF_TFA_CAPTURE=1`` (with ``CF_TFA_CHECK=1``) dumps the inputs of the first
+mismatching call per shape to ``CF_TFA_CAPTURE_DIR`` for offline replay.
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+import torch
+
+_ENABLED: bool | None = None
+_DBG = os.environ.get("CF_TFA_DEBUG", "0") == "1"
+_MOD = None
+_SRC = Path(__file__).resolve().parent / "tree_attn_fused.cu"
+
+# head_size -> instantiated; anything else falls back to eager
+_SUPPORTED_D = (64, 128, 256)
+
+
+def _load():
+    """Build/load the extension.  Called from ``enabled()`` so the (cached)
+    ninja build happens at model-load time, never inside a CUDA-graph capture."""
+    global _MOD
+    if _MOD is None:
+        from torch.utils.cpp_extension import load
+
+        os.environ.setdefault("CUDA_HOME", "/usr/local/cuda")
+        os.environ.setdefault("TORCH_CUDA_ARCH_LIST", "12.0")
+        _MOD = load(
+            name="cf_tree_attn_fused",
+            sources=[str(_SRC)],
+            extra_cuda_cflags=["-O3", "-lineinfo", "--expt-relaxed-constexpr"],
+            verbose=False,
+        )
+    return _MOD
+
+
+def enabled() -> bool:
+    global _ENABLED
+    if _ENABLED is None:
+        _ENABLED = os.environ.get("CF_TREE_FUSED_ATTN", "0") == "1"
+        if _ENABLED:
+            _load()
+    return _ENABLED
+
+
+_CHK = None
+_CHECK_MODE = int(os.environ.get("CF_TFA_CHECK", "0") or 0)
+_FALLBACK = os.environ.get("CF_TFA_FORCE_FALLBACK") == "1"
+# 4 warps/block measured best at BOTH shipping shapes (4B/9B H=16 and 27B H=24);
+# occupancy preference does not transfer between kernels, so this is measured,
+# not inherited -- see the warps x CH grid in the module docstring.
+_WARPS = int(os.environ.get("CF_TFA_WARPS", "0") or 0) or 4
+_GK = int(os.environ.get("CF_TFA_GK", "0") or 0) or 8
+
+
+def check_mode() -> int:
+    """CF_TFA_CHECK: 1 = run the eager tail alongside the kernel and tally
+    mismatching output elements in a device counter -- no host sync, so it works
+    under cudagraph REPLAY, which is the only way to see the shipping static
+    step (its python never runs again after capture).  2 = eager tail only, an
+    A/A control that must reproduce the flag-OFF tokens exactly."""
+    return _CHECK_MODE
+
+
+_CHK_BY: dict = {}
+_CAPTURE = os.environ.get("CF_TFA_CAPTURE", "0") == "1"
+_CAP: dict = {}
+_CAP_DIR = os.environ.get("CF_TFA_CAPTURE_DIR", "/tmp/cf_tfa_capture")
+
+
+def tally(got: torch.Tensor, ref: torch.Tensor, key: str = "") -> None:
+    """Tally mismatching elements.  ``key`` gives a per-shape breakdown: a
+    single global counter cannot say WHICH of the shapes a run dispatches
+    (verify tree, cudagraph-warmup batches) is the one that diverges."""
+    global _CHK
+    if _CHK is None:
+        _CHK = torch.zeros(4, dtype=torch.int64, device=got.device)
+    both_nan = torch.isnan(got.float()) & torch.isnan(ref.float())
+    bad = (got != ref) & ~both_nan
+    nbad = bad.sum()
+    anyb = bad.any()
+    _CHK[0] += nbad
+    _CHK[1] += got.numel()
+    _CHK[2] += anyb.to(torch.int64)
+    _CHK[3] += 1
+    if key:
+        c = _CHK_BY.get(key)
+        if c is None:
+            # allocated on the first (eager, pre-capture) call for this shape
+            c = _CHK_BY[key] = torch.zeros(4, dtype=torch.int64, device=got.device)
+        c[0] += nbad
+        c[1] += got.numel()
+        c[2] += anyb.to(torch.int64)
+        c[3] += 1
+
+
+def capturing() -> bool:
+    return _CAPTURE
+
+
+def capture(anyb: torch.Tensor, tensors: dict, key: str) -> None:
+    """CF_TFA_CAPTURE=1: snapshot the inputs of the FIRST mismatching call into
+    persistent device buffers, entirely with device-side ops so it is legal
+    inside a captured cudagraph (a host-side `if` would freeze the decision at
+    capture time and never fire on replay).  Buffers are PER SHAPE -- a run
+    dispatches several (the shipping step plus every cudagraph-warmup batch) and
+    one buffer set cannot hold them.  Dumped at exit."""
+    if not _CAP:
+        import atexit
+
+        atexit.register(_dump)
+    buf = _CAP.get(key)
+    if buf is None:
+        buf = _CAP[key] = {
+            "_seen": torch.zeros((), dtype=torch.int64, device=anyb.device)
+        }
+    seen = buf["_seen"]
+    first = (seen == 0) & anyb
+    seen += first.to(torch.int64)
+    for name, src in tensors.items():
+        dst = buf.get(name)
+        if dst is None:
+            dst = buf[name] = torch.zeros_like(src)
+        dst.copy_(torch.where(first, src, dst))
+
+
+def _dump() -> None:
+    if not _CAP:
+        return
+    os.makedirs(_CAP_DIR, exist_ok=True)
+    for key, buf in _CAP.items():
+        if int(buf["_seen"]) == 0:
+            continue
+        path = os.path.join(_CAP_DIR, f"first_mismatch_{key}.pt")
+        torch.save({k: v.cpu() for k, v in buf.items()}, path)
+        print(f"[cf-tfa] captured first-mismatch inputs -> {path}", flush=True)
+
+
+def _label(c: list) -> dict:
+    return {
+        "mismatching_elements": c[0],
+        "elements": c[1],
+        "calls_with_a_mismatch": c[2],
+        "calls": c[3],
+    }
+
+
+def check_counters():
+    """Returns a LABELLED dict, deliberately.  This used to return the bare
+    4-list ``[mismatching elements, elements, calls with a mismatch, calls]``,
+    and the caller prints it verbatim under the banner "mismatching output
+    elements: ..."; a 27B run reading ``[0, 2811494400, 0, 10048]`` off that
+    line was written up as "10,048 mismatching of 2,811,494,400", which is the
+    CALL COUNT against the element count -- the run had zero mismatches.  That
+    misreading cost a full root-cause investigation, so the field names now
+    travel with the numbers."""
+    if _CHK is None:
+        return None
+    if _CHK_BY:
+        for k in sorted(_CHK_BY):
+            print(f"[cf-tfa-check]   {k}: {_label(_CHK_BY[k].tolist())}", flush=True)
+    return _label(_CHK.tolist())
+
+
+
+def fused_suffix_merge(
+    *,
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    output: torch.Tensor,
+    prefix_out: torch.Tensor,
+    prefix_lse: torch.Tensor,
+    idx_pad: torch.Tensor,
+    not_anc: torch.Tensor,
+    scale: float,
+    S: int,
+    N: int,
+) -> bool:
+    """Returns False if this shape is not handled -- caller must fall back."""
+    D = query.shape[2]
+    if _FALLBACK:
+        return False  # A/A control: everything else identical, eager tail runs
+    if D not in _SUPPORTED_D or query.dtype not in (torch.bfloat16, torch.float16):
+        return False
+    # vectorised 4/8/16-byte lane loads: the head must be contiguous and every
+    # row/head stride a whole number of vectors.
+    vpt = D // 32
+    for t in (query, key, value, output, prefix_out):
+        if t.stride(2) != 1 or t.stride(0) % vpt or t.stride(1) % vpt:
+            return False
+    # the kernel indexes these with a packed layout
+    if (
+        prefix_lse.dtype != torch.float32
+        or prefix_lse.stride() != (S * N, 1)
+        or not idx_pad.is_contiguous()
+        or idx_pad.dtype != torch.int64
+        or not not_anc.is_contiguous()
+    ):
+        return False
+    # N >= 128 falls back to eager, for TWO separate reasons:
+    #  * N > 128 does not fit the MAXW=4-word ancestor bitmask at all;
+    #  * N == 128 fits, but is NOT bit-exact.  cuBLAS switches SGEMM tiling at
+    #    exactly m=n=128, so the reference q.k^T stops being the strictly
+    #    sequential FFMA chain this kernel reproduces.  Swept N = 8..128 x
+    #    {fp16, bf16} x H in {16, 24}: every N <= 127 is exact over 39 M
+    #    elements per size, and N == 128 alone mismatches (181 elements).
+    #    An inexact fast path is worse than no fast path, so 128 is refused.
+    if N >= 128:
+        return False
+    warps, gk = _WARPS, _GK
+    global _DBG
+    if _DBG:
+        _DBG = False
+        print(f"[cf-tfa] CUDA kernel live: S={S} N={N} H={query.shape[1]} "
+              f"HKV={key.shape[1]} D={D} dtype={query.dtype} warps={warps} "
+              f"gk={gk}", flush=True)
+    _load().suffix_merge(
+        query,
+        key,
+        value,
+        output,
+        prefix_out,
+        prefix_lse,
+        idx_pad,
+        not_anc,
+        float(scale),
+        int(S),
+        int(N),
+        warps,
+        gk,
+    )
+    return True
