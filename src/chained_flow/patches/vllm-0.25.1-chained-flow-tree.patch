+  float bh[BV][4];
+  {
+    const ST *p = state + (long)init_slot[t] * stride_state_slot +
+                  (long)i_hv * VD * KD + (long)(i_v * BV) * KD + k0;
+#pragma unroll
+    for (int u = 0; u < BV; ++u) {
+      if (sizeof(ST) == 4) {
+        const float4 f = *reinterpret_cast<const float4 *>(p + (long)u * KD);
+        bh[u][0] = f.x; bh[u][1] = f.y; bh[u][2] = f.z; bh[u][3] = f.w;
+      } else {
+#pragma unroll
+        for (int j = 0; j < 4; ++j) bh[u][j] = cvt(p[(long)u * KD + j]);
+      }
+    }
+  }
